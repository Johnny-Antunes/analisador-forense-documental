import pandas as pd
import json
import re
import os
from pathlib import Path
import networkx as nx
import webbrowser

# =====================================================
# 1. CAMINHO DA PASTA COM AS EXTRAÇÕES DIÁRIAS
# =====================================================
PASTA_ORIGEM = Path(__file__).parent / "casos_duplicidade"
PASTA_ORIGEM.mkdir(exist_ok=True)

arquivos_excel = list(PASTA_ORIGEM.glob("*.xlsx"))

if not arquivos_excel:
    print(f"⚠️ Nenhum arquivo .xlsx encontrado em: {PASTA_ORIGEM}")
    print("Copie os arquivos diários para a pasta e execute novamente.")
    exit()

print(f"📂 Encontrados {len(arquivos_excel)} arquivos. Consolidando base...")

# =====================================================
# 2. CONSOLIDAÇÃO E LIMPEZA FORENSE DOS DADOS
# =====================================================
lista_dfs = []

for arq in arquivos_excel:
    try:
        # Lê mantendo tipos originais para inspecionar
        temp_df = pd.read_excel(arq)
        temp_df["_ARQUIVO_ORIGEM"] = arq.name
        lista_dfs.append(temp_df)
    except Exception as e:
        print(f"Erro ao ler {arq.name}: {e}")

df_bruto = pd.concat(lista_dfs, ignore_index=True)
print(f"📊 Total de registros: {len(df_bruto)} linhas.")

def normalizar_valor_bruto(val):
    """Trata notação científica, ponto flutuante (.0) e nulos do Excel."""
    if pd.isna(val):
        return ""
    
    # Se já vier como float ou int nativo do Excel
    if isinstance(val, (float, int)):
        if pd.isna(val):
            return ""
        return f"{int(val)}"
    
    v = str(val).strip()
    if v.lower() in ["nan", "none", "null", "-", "nat", ""]:
        return ""
    
    # Se for string em notação científica (ex: '1,20E+10' ou '1.65E+10')
    if re.search(r"[eE][+-]?\d+", v):
        try:
            num = float(v.replace(",", "."))
            return f"{int(num)}"
        except Exception:
            pass
            
    # Se for string numérica terminada em .0 (ex: '39693466810.0')
    if re.match(r"^\d+\.0+$", v):
        return v.split(".")[0]
        
    return v

def limpar_placa(val):
    if pd.isna(val):
        return ""
    v = str(val).strip().upper()
    placa = re.sub(r"[^A-Z0-9]", "", v)
    return placa if len(placa) == 7 else ""

def limpar_cpf_cnpj(val):
    v = normalizar_valor_bruto(val)
    nums = re.sub(r"\D", "", v)
    if not nums:
        return ""
    
    # Se o número foi truncado na exportação (ex: 12000000000), não gera nó falso
    if nums.endswith("0000000"):
        return ""

    # CPF: completa zeros à esquerda se perdeu na conversão (ex: 3116657807 -> 03116657807)
    if len(nums) <= 11:
        nums = nums.zfill(11)
        # Validação básica: descarta sequências inválidas conhecidas
        if len(set(nums)) == 1:
            return ""
        return nums
    
    # CNPJ: completa até 14 dígitos
    elif len(nums) <= 14:
        return nums.zfill(14)
        
    return nums

def limpar_tel(val):
    v = normalizar_valor_bruto(val)
    nums = re.sub(r"\D", "", v)
    
    # Descarta telefones truncados por notação científica sem resolução
    if nums.endswith("000000"):
        return ""
        
    # Remove zero inicial de DDD se houver (ex: 0119... -> 119...)
    if len(nums) in [11, 12] and nums.startswith("0"):
        nums = nums[1:]
        
    # Mantém apenas telefones com tamanho plausível (fixo 10 ou celular 11 dígitos com DDD)
    return nums if len(nums) in [10, 11] else ""

def encontrar_col(df, nomes):
    colunas_df = {str(c).strip().lower(): c for c in df.columns}
    
    # 1. Busca exata prioritária
    for n in nomes:
        if n in colunas_df:
            return colunas_df[n]
            
    # 2. Busca parcial (fallback)
    for c_low, c_orig in colunas_df.items():
        if any(n in c_low for n in nomes):
            return c_orig
    return None

col_cpf = encontrar_col(df_bruto, ["cpf_cnpj_usuario", "cpf", "cnpj", "documento"])
col_tel = encontrar_col(df_bruto, ["telefone_titular", "telefone", "celular", "tel"])
col_placa = encontrar_col(df_bruto, ["placa", "veiculo", "veículo"])

print(f"🔍 Colunas mapeadas -> CPF/CNPJ: '{col_cpf}' | Telefone: '{col_tel}' | Placa: '{col_placa}'")

# =====================================================
# 3. CONSTRUÇÃO DO GRAFO (NETWORKX)
# =====================================================
G = nx.Graph()

for _, row in df_bruto.iterrows():
    cpf = limpar_cpf_cnpj(row[col_cpf]) if col_cpf else ""
    tel = limpar_tel(row[col_tel]) if col_tel else ""
    placa = limpar_placa(row[col_placa]) if col_placa else ""
    
    entidades_linha = []
    if cpf:
        id_cpf = f"CPF_{cpf}"
        G.add_node(id_cpf, label=f"👤 {cpf}", group="cpf", title=f"CPF/CNPJ: {cpf}")
        entidades_linha.append(id_cpf)
    if tel:
        id_tel = f"TEL_{tel}"
        G.add_node(id_tel, label=f"🚨 {tel}", group="telefone", title=f"TELEFONE: {tel}")
        entidades_linha.append(id_tel)
    if placa:
        id_placa = f"PLACA_{placa}"
        G.add_node(id_placa, label=f"🚗 {placa}", group="placa", title=f"PLACA: {placa}")
        entidades_linha.append(id_placa)
        
    for i in range(len(entidades_linha)):
        for j in range(i + 1, len(entidades_linha)):
            G.add_edge(entidades_linha[i], entidades_linha[j])

componentes = list(nx.connected_components(G))
componentes.sort(key=len, reverse=True)

print(f"⚡ Vínculos processados: {len(componentes)} células independentes encontradas.")

# =====================================================
# 4. EXPORTAÇÃO ESTRUTURADA
# =====================================================
vis_nodes = []
vis_edges = []
cluster_summary = []

for cluster_id, comp in enumerate(componentes, 1):
    subgrafo = G.subgraph(comp)
    qtd_nos = len(comp)
    
    graus = dict(subgrafo.degree())
    maior_hub_id = max(graus, key=graus.get)
    maior_hub_nome = G.nodes[maior_hub_id]["label"]
    
    cluster_summary.append({
        "cluster_id": cluster_id,
        "tamanho": qtd_nos,
        "hub": maior_hub_nome,
        "grau_hub": graus[maior_hub_id]
    })
    
    for n in comp:
        n_data = G.nodes[n]
        vis_nodes.append({
            "id": n,
            "label": n_data["label"],
            "group": n_data["group"],
            "title": n_data["title"],
            "cluster": cluster_id,
            "degree": graus[n]
        })
        
    for u, v in subgrafo.edges():
        vis_edges.append({
            "from": u,
            "to": v,
            "cluster": cluster_id
        })

