        function filterCluster(cId) {{
            if (cId === "ALL") {{
                nodesDataSet.clear();
                edgesDataSet.clear();
                nodesDataSet.add(rawNodes.slice(0, 300));
                edgesDataSet.add(rawEdges.filter(e => nodesDataSet.get(e.from) && nodesDataSet.get(e.to)));
