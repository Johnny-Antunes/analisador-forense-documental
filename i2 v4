# =====================================================
# 1. LOCALIZAÇÃO E LEITURA DOS ARQUIVOS
# =====================================================
PASTA_ORIGEM = Path(__file__).parent / "casos_duplicidade"
PASTA_ORIGEM.mkdir(exist_ok=True)

arquivos_excel = list(PASTA_ORIGEM.glob("*.xlsx"))

if not arquivos_excel:
    print(f"⚠️ Nenhum arquivo .xlsx encontrado em: {PASTA_ORIGEM}")
    print("Coloque os arquivos diários na pasta 'casos_duplicidade' e execute novamente.")
    exit()

print(f"📂 Encontrados {len(arquivos_excel)} arquivos diários. Consolidando...")

lista_dfs = []
for arq in arquivos_excel:
    try:
        temp_df = pd.read_excel(arq)
        temp_df["_ARQUIVO_ORIGEM"] = arq.name
        lista_dfs.append(temp_df)
    except Exception as e:
        print(f"Erro ao ler {arq.name}: {e}")

df_bruto = pd.concat(lista_dfs, ignore_index=True)
print(f"📊 Total de registros brutos: {len(df_bruto)} linhas.")

# =====================================================
# 2. TRATAMENTO FORENSE DE DADOS
# =====================================================
def normalizar_valor_bruto(val):
    """Trata notação científica (1,20E+10), float com .0 e nulos."""
    if pd.isna(val):
        return ""
    if isinstance(val, (float, int)):
        if pd.isna(val):
            return ""
        return f"{int(val)}"
    
    v = str(val).strip()
    if v.lower() in ["nan", "none", "null", "-", "nat", ""]:
        return ""
    
    if re.search(r"[eE][+-]?\d+", v):
        try:
            num = float(v.replace(",", "."))
            return f"{int(num)}"
        except Exception:
            pass
            
    if re.match(r"^\d+\.0+$", v):
        return v.split(".")[0]
        
    return v

def limpar_placa(val):
    if pd.isna(val):
        return ""
    v = str(val).strip().upper()
    placa = re.sub(r"[^A-Z0-9]", "", v)
    return placa if len(placa) == 7 else ""

def limpar_cpf_cnpj(val):
    v = normalizar_valor_bruto(val)
    nums = re.sub(r"\D", "", v)
    if not nums or nums.endswith("0000000"):
        return ""
    
    # CPF: recupera zeros cortados à esquerda (ex: 3116657807 -> 03116657807)
    if len(nums) <= 11:
        nums = nums.zfill(11)
        if len(set(nums)) == 1:
            return ""
        return nums
    elif len(nums) <= 14:
        return nums.zfill(14)
    return nums

def formatar_cpf_cnpj(digits):
    if len(digits) == 11:
        return f"{digits[:3]}.{digits[3:6]}.{digits[6:9]}-{digits[9:]}"
    elif len(digits) == 14:
        return f"{digits[:2]}.{digits[2:5]}.{digits[5:8]}/{digits[8:12]}-{digits[12:]}"
    return digits

def limpar_tel(val):
    v = normalizar_valor_bruto(val)
    nums = re.sub(r"\D", "", v)
    if not nums or nums.endswith("000000"):
        return ""
    if len(nums) in [12, 13] and nums.startswith("55"):
        nums = nums[2:]
    if len(nums) in [11, 12] and nums.startswith("0"):
        nums = nums[1:]
    return nums if len(nums) in [10, 11] else ""

def formatar_tel(digits):
    if len(digits) == 11:
        return f"({digits[:2]}) {digits[2:7]}-{digits[7:]}"
    elif len(digits) == 10:
        return f"({digits[:2]}) {digits[2:6]}-{digits[6:]}"
    return digits

def encontrar_col(df, nomes):
    colunas_df = {re.sub(r'[^a-z0-9]', '', str(c).strip().lower()): c for c in df.columns}
    for n in nomes:
        n_clean = re.sub(r'[^a-z0-9]', '', n.lower())
        if n_clean in colunas_df:
            return colunas_df[n_clean]
    for c_clean, c_orig in colunas_df.items():
        if any(re.sub(r'[^a-z0-9]', '', n.lower()) in c_clean for n in nomes):
            return c_orig
    return None

col_cpf = encontrar_col(df_bruto, ["cpf_cnpj_usuario", "cpf_cnpj", "cpf", "cnpj", "documento"])
col_tel = encontrar_col(df_bruto, ["telefone_titular", "telefone", "celular", "tel", "contato"])
col_placa = encontrar_col(df_bruto, ["placa", "veiculo", "veículo", "auto"])
col_nome = encontrar_col(df_bruto, ["titular", "nome_cliente", "nome", "segurado", "cliente"])

print(f"🔍 Colunas Mapeadas:")
print(f"  • CPF/CNPJ: {col_cpf}")
print(f"  • Telefone: {col_tel}")
print(f"  • Placa:    {col_placa}")
print(f"  • Titular:  {col_nome}\n")

# =====================================================
# 3. CONSTRUÇÃO DO GRAFO (APENAS ENTIDADES FIXAS)
# =====================================================
G = nx.Graph()
edges_set = set()

cores_grupos = {
    "telefone": {"background": "#B91C1C", "border": "#EF4444"},
    "cpf": {"background": "#0284C7", "border": "#38BDF8"},
    "placa": {"background": "#7C3AED", "border": "#A78BFA"}
}

def add_edge_clean(u, v):
    par = tuple(sorted([str(u), str(v)]))
    if par not in edges_set:
        edges_set.add(par)
        G.add_edge(u, v)

for idx, row in df_bruto.iterrows():
    cpf_raw = limpar_cpf_cnpj(row[col_cpf]) if col_cpf else ""
    tel_raw = limpar_tel(row[col_tel]) if col_tel else ""
    placa_raw = limpar_placa(row[col_placa]) if col_placa else ""
    nome_raw = str(row[col_nome]).strip() if col_nome and pd.notna(row[col_nome]) else ""
    
    # Exige ao menos duas entidades para que exista relação na linha
    entidades_presentes = sum([bool(cpf_raw or nome_raw), bool(tel_raw), bool(placa_raw)])
    if entidades_presentes < 2:
        continue

    # 1. Nó Titular
    titular_id = f"CPF_{cpf_raw}" if cpf_raw else f"NOME_{nome_raw}"
    label_titular = f"👤 {nome_raw}" if nome_raw else (f"👤 {formatar_cpf_cnpj(cpf_raw)}" if cpf_raw else f"👤 Registro #{idx+1}")
    title_titular = f"TITULAR: {nome_raw or 'Não informado'}\nCPF: {formatar_cpf_cnpj(cpf_raw)}"
    
    if titular_id not in G:
        G.add_node(titular_id, label=label_titular, group="cpf", title=title_titular, base_size=13, level=2)
    
    # 2. Nó Telefone
    if tel_raw:
        tel_id = f"TEL_{tel_raw}"
        tel_fmt = formatar_tel(tel_raw)
        if tel_id not in G:
            G.add_node(tel_id, label=f"🚨 {tel_fmt}", group="telefone", title=f"TELEFONE DE CONTATO:\n{tel_fmt}", base_size=13, level=1)
        add_edge_clean(titular_id, tel_id)
        
    # 3. Nó Placa
    if placa_raw:
        placa_id = f"PLACA_{placa_raw}"
        placa_fmt = f"{placa_raw[:3]}-{placa_raw[3:]}" if len(placa_raw) == 7 else placa_raw
        if placa_id not in G:
            G.add_node(placa_id, label=f"🚗 {placa_fmt}", group="placa", title=f"PLACA DO VEÍCULO:\n{placa_fmt}", base_size=13, level=3)
        add_edge_clean(titular_id, placa_id)

# Remove nós órfãos (sem conexões) para limpar a memória
G.remove_nodes_from(list(nx.isolates(G)))

componentes = list(nx.connected_components(G))
componentes.sort(key=len, reverse=True)

print(f"⚡ Estrutura gerada: {len(componentes)} células independentes encontradas.")

# =====================================================
# 4. EXPORTAÇÃO ESTRUTURADA
# =====================================================
vis_nodes = []
vis_edges = []
cluster_summary = []

for cluster_id, comp in enumerate(componentes, 1):
    subgrafo = G.subgraph(comp)
    qtd_entidades = len(comp)
    
    graus = dict(subgrafo.degree())
    maior_hub_id = max(graus, key=graus.get)
    maior_hub_label = G.nodes[maior_hub_id]["label"]
    
    cluster_summary.append({
        "cluster_id": cluster_id,
        "tamanho": qtd_entidades,
        "hub": maior_hub_label,
        "grau_hub": graus[maior_hub_id]
    })
    
    for n in comp:
        n_data = G.nodes[n]
        cfg_cor = cores_grupos[n_data["group"]]
        vis_nodes.append({
            "id": n,
            "label": n_data["label"],
            "group": n_data["group"],
            "title": n_data["title"],
            "cluster": cluster_id,
            "base_size": n_data["base_size"],
            "level": n_data.get("level", 2),
            "color": {
                "background": cfg_cor["background"],
                "border": cfg_cor["border"],
                "highlight": {"background": cfg_cor["border"], "border": "#FFFFFF"}
            },
            "font": {"color": "#FFFFFF", "size": n_data["base_size"], "bold": True, "face": "Segoe UI"}
        })
        
    for u, v in subgrafo.edges():
        vis_edges.append({
            "from": u,
            "to": v,
            "cluster": cluster_id,
            "color": {"color": "#475569"},
            "width": 2.0
        })

