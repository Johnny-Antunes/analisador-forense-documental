    <script>
        const allNodes = {json.dumps(vis_nodes)};
        const allEdges = {json.dumps(vis_edges)};
        
        const nodesDataSet = new vis.DataSet();
        const edgesDataSet = new vis.DataSet();
        
        const container = document.getElementById('network');
        const data = {{ nodes: nodesDataSet, edges: edgesDataSet }};
        
        let physicsEnabled = true;
        let globalFontMultiplier = 1.0;
        let isZoomUpdating = false;
        let currentClusterId = "1";
        
        const options = {{
            groups: {{
                telefone: {{
                    color: {{ background: "#B91C1C", border: "#EF4444", highlight: {{ background: "#EF4444", border: "#FFFFFF" }} }},
                    shape: "box",
                    font: {{ color: "#FFFFFF", bold: true, face: "Segoe UI" }}
                }},
                cpf: {{
                    color: {{ background: "#0284C7", border: "#38BDF8", highlight: {{ background: "#38BDF8", border: "#FFFFFF" }} }},
                    shape: "box",
                    font: {{ color: "#FFFFFF", bold: true, face: "Segoe UI" }}
                }},
                placa: {{
                    color: {{ background: "#7C3AED", border: "#A78BFA", highlight: {{ background: "#A78BFA", border: "#FFFFFF" }} }},
                    shape: "box",
                    font: {{ color: "#FFFFFF", bold: true, face: "Segoe UI" }}
                }}
            }},
            edges: {{
                color: {{ color: "#475569", highlight: "#38BDF8" }},
                width: 2.0,
                smooth: {{ type: "continuous" }}
            }},
            physics: {{
                barnesHut: {{
                    gravitationalConstant: -3500,
                    centralGravity: 0.15,
                    springLength: 140,
                    springConstant: 0.05,
                    damping: 0.85,
                    avoidOverlap: 0.2
                }},
                solver: 'barnesHut',
                stabilization: {{
                    enabled: true,
                    iterations: 100,
                    updateInterval: 25
                }}
            }},
            interaction: {{
                hover: true,
                zoomView: true,
                dragNodes: true
            }}
        }};
        
        const network = new vis.Network(container, data, options);

        // Foco e Isolamento ao Clicar em um Nó
        network.on("click", function(params) {{
            if (params.nodes.length > 0) {{
                const selectedNodeId = params.nodes[0];
                const connectedNodes = network.getConnectedNodes(selectedNodeId);
                connectedNodes.push(selectedNodeId);
                
                const updates = nodesDataSet.get().map(node => {{
                    const orig = allNodes.find(item => item.id === node.id);
                    return {{
                        id: node.id,
                        opacity: connectedNodes.includes(node.id) ? 1.0 : 0.12,
                        color: orig.color
                    }};
                }});
                nodesDataSet.update(updates);
            }} else {{
                const updates = nodesDataSet.get().map(node => {{
                    const orig = allNodes.find(item => item.id === node.id);
                    return {{
                        id: node.id,
                        opacity: 1.0,
                        color: orig.color
                    }};
                }});
                nodesDataSet.update(updates);
            }}
        }});

        function updateFontScale() {{
            if (!document.getElementById('chk-adaptive-font').checked) return;
            const currentScale = network.getScale();
            if (!currentScale || currentScale <= 0.05 || isNaN(currentScale)) return;
            
            const currentNodes = nodesDataSet.get();
            const updates = [];
            
            currentNodes.forEach(n => {{
                const orig = allNodes.find(item => item.id === n.id);
                if (!orig) return;
                
                let targetSize = Math.round((orig.base_size * globalFontMultiplier) / currentScale);
                targetSize = Math.max(9, Math.min(36, targetSize));
                
                updates.push({{
                    id: n.id,
                    font: {{ size: targetSize, color: "#FFFFFF", bold: true, face: "Segoe UI" }},
                    color: orig.color
                }});
            }});
            
            if (updates.length > 0) {{
                nodesDataSet.update(updates);
            }}
        }}

        network.on("zoom", function() {{
            if (document.getElementById('chk-adaptive-font').checked) {{
                if (!isZoomUpdating) {{
                    isZoomUpdating = true;
                    requestAnimationFrame(() => {{
                        updateFontScale();
                        isZoomUpdating = false;
                    }});
                }}
            }}
        }});

        function onFontSizeSlider(val) {{
            globalFontMultiplier = parseFloat(val) / 13.0;
            document.getElementById('lbl-font-val').innerText = val + 'px';
            updateFontScale();
        }}

        function applyFilters() {{
            const showTel = document.getElementById('chk-tel').checked;
            const showCpf = document.getElementById('chk-cpf').checked;
            const showPlaca = document.getElementById('chk-placa').checked;
            
            const activeGroups = [];
            if (showTel) activeGroups.push('telefone');
            if (showCpf) activeGroups.push('cpf');
            if (showPlaca) activeGroups.push('placa');
            
            const numId = parseInt(currentClusterId);
            let filteredNodes = allNodes.filter(n => activeGroups.includes(n.group) && n.cluster === numId);
            
            const visibleIds = new Set(filteredNodes.map(n => n.id));
            const filteredEdges = allEdges.filter(e => visibleIds.has(e.from) && visibleIds.has(e.to));
            
            nodesDataSet.clear();
            edgesDataSet.clear();
            nodesDataSet.add(filteredNodes);
            edgesDataSet.add(filteredEdges);
            
            setTimeout(() => {{
                network.fit({{ animation: {{ duration: 350 }} }});
                setTimeout(updateFontScale, 150);
            }}, 100);
        }}

        function filterCluster(cId) {{
            currentClusterId = cId;
            applyFilters();
        }}

        function changeLayout(mode) {{
            if (mode === "physics") {{
                network.setOptions({{
                    layout: {{ hierarchical: false }},
                    physics: {{
                        enabled: true,
                        solver: 'barnesHut'
                    }}
                }});
            }} else if (mode === "hierarchical_ud") {{
                network.setOptions({{
                    layout: {{
                        hierarchical: {{
                            direction: "UD",
                            sortMethod: "directed",
                            levelSeparation: 140,
                            nodeSpacing: 160
                        }}
                    }},
                    physics: {{ enabled: false }}
                }});
            }} else if (mode === "hierarchical_lr") {{
                network.setOptions({{
                    layout: {{
                        hierarchical: {{
                            direction: "LR",
                            sortMethod: "directed",
                            levelSeparation: 200,
                            nodeSpacing: 90
                        }}
                    }},
                    physics: {{ enabled: false }}
                }});
            }}
            setTimeout(() => network.fit({{ animation: {{ duration: 350 }} }}), 150);
        }}

        function searchNode(text) {{
            const val = text.trim().toLowerCase();
            if (!val) return;
            
            const found = allNodes.find(n => n.label.toLowerCase().includes(val) || n.title.toLowerCase().includes(val));
            if (found) {{
                if (currentClusterId !== String(found.cluster)) {{
                    document.getElementById('sel-cluster').value = String(found.cluster);
                    currentClusterId = String(found.cluster);
                    applyFilters();
                }}
                setTimeout(() => {{
                    network.focus(found.id, {{ scale: 1.3, animation: {{ duration: 400 }} }});
                    network.selectNodes([found.id]);
                }}, 250);
