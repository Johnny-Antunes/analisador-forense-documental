            )

            tooltip = {
                "html": """
                    <div style="font-family:'Segoe UI', Tahoma, sans-serif; padding:4px;">
                        <b style="color:#38BDF8;">🚨 Assistência: {id_assistencia}</b><br/>
                        <b>Titular:</b> {titular}<br/>
                        <b>CPF:</b> {cpf}<br/>
                        <b>Placa:</b> {placa}<br/>
