    <script>
        function sendValueToStreamlit(value) {
            window.parent.postMessage({ isStreamlitMessage: true, type: "streamlit:setComponentValue", value: value, dataType: "json" }, "*");
        }
        function setFrameHeightStreamlit(height) {
            window.parent.postMessage({ isStreamlitMessage: true, type: "streamlit:setFrameHeight", height: height }, "*");
        }
        function notifyReadyStreamlit() {
            window.parent.postMessage({ isStreamlitMessage: true, type: "streamlit:componentReady", apiVersion: 1 }, "*");
        }

        let rawNodes = [], rawEdges = [], masterHubId = "", targetSearchId = "";
        let initialLayout = "organico", baseFontSize = 11, assinaturaDadosAtual = "";
        let network = null;
        const nodesDataSet = new vis.DataSet([]);
        const edgesDataSet = new vis.DataSet([]);
        let nodeIndexMap = new Map(), adjacencyMap = new Map(), adjacencySimples = new Map();
        let contextMenuNodeId = null, currentInspectedNodeId = null, currentHighlightId = null;
        let selectedNodesQueue = [];
        let modoSelecaoAtivo = false;
        let isLodSimplified = false;
        let temaAtualBg = '#161616';
        let isAdaptive = true;
        const container = document.getElementById('network');

        // --- Grid Pontilhado Forense ---
        function desenharGridPontilhado(ctx) {
            if (!network) return;
            const canvasEl = container.querySelector('canvas');
            if (!canvasEl) return;
            const topLeft = network.DOMtoCanvas({ x: 0, y: 0 });
            const bottomRight = network.DOMtoCanvas({ x: canvasEl.clientWidth, y: canvasEl.clientHeight });
            const espacamentoGrid = 42;
            if (((bottomRight.x - topLeft.x) / espacamentoGrid) * ((bottomRight.y - topLeft.y) / espacamentoGrid) > 6000) return;
            const startX = Math.floor(topLeft.x / espacamentoGrid) * espacamentoGrid;
            const startY = Math.floor(topLeft.y / espacamentoGrid) * espacamentoGrid;
            ctx.save();
            ctx.fillStyle = "rgba(184, 184, 184, 0.14)";
            for (let x = startX; x <= bottomRight.x; x += espacamentoGrid) {
                for (let y = startY; y <= bottomRight.y; y += espacamentoGrid) {
                    ctx.beginPath();
                    ctx.arc(x, y, 1.2, 0, 2 * Math.PI);
                    ctx.fill();
                }
            }
            ctx.restore();
        }

        // --- LOD ADAPTATIVO REAL COM DIMENSIONAMENTO PROPORCIONAL AO ZOOM ---
        function updateAdaptiveLOD() {
            if (!isAdaptive || !network) return;
            const scale = network.getScale();
            if (!scale || scale <= 0.002) return;

            const lodIndicator = document.getElementById('lod-indicator');

            // Limiar de LOD: scale < 0.25 ativa modo de pontos simplificados
            if (scale < 0.25) {
                // Diâmetro em canvas inversamente proporcional ao zoom: garante visibilidade (4-6px na tela)
                const screenTargetRadius = 4.2;
                const dynamicDotSize = Math.max(8, Math.min(65, Math.round(screenTargetRadius / scale)));
                const hubDotSize = Math.round(dynamicDotSize * 1.8);

                isLodSimplified = true;
                if (lodIndicator) lodIndicator.textContent = `LOD: Dot (${scale.toFixed(2)}x)`;

                const updates = [];
                nodesDataSet.forEach(n => {
                    const isHub = (n.id === masterHubId);
                    updates.push({
                        id: n.id,
                        shape: "dot",
                        size: isHub ? hubDotSize : dynamicDotSize,
                        label: ""
                    });
                });
                nodesDataSet.update(updates);
                return;
            } else if (scale >= 0.25 && isLodSimplified) {
                // Restaura o ícone completo, pílula de rótulo e tamanho original
                isLodSimplified = false;
                if (lodIndicator) lodIndicator.textContent = `LOD: Full (${scale.toFixed(2)}x)`;
                const updates = [];
                nodesDataSet.forEach(n => {
                    const orig = nodeIndexMap.get(n.id);
                    if (!orig) return;
                    updates.push({
                        id: n.id,
                        shape: orig.shape || (orig.image ? "image" : "dot"),
                        image: orig.image,
                        size: orig.size || 20,
                        label: orig.label
                    });
                });
                nodesDataSet.update(updates);
            }

            // No modo Full, tipografia com contorno anti-ruído
            if (!isLodSimplified) {
                const targetSize = Math.max(9, Math.min(20, Math.round(baseFontSize / Math.sqrt(scale))));
                const updates = [];
                nodesDataSet.forEach(n => updates.push({
                    id: n.id,
                    font: {
                        size: targetSize,
                        color: "#EDEDED",
                        face: "Segoe UI",
                        strokeWidth: 2.5,
                        strokeColor: temaAtualBg
                    }
                }));
                nodesDataSet.update(updates);
            }
        }

        // --- Minimapa com Frustum da Câmera em #FF7300 ---
        function desenharMinimapa() {
            const canvas = document.getElementById('minimap-canvas');
            if (!canvas || !network) return;
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            const positions = network.getPositions();
            const ids = Object.keys(positions);
            if (ids.length === 0) return;
            let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
            ids.forEach(id => {
                const p = positions[id];
                if (p) {
                    minX = Math.min(minX, p.x); maxX = Math.max(maxX, p.x);
                    minY = Math.min(minY, p.y); maxY = Math.max(maxY, p.y);
                }
            });
            const rangeX = Math.max(maxX - minX, 1), rangeY = Math.max(maxY - minY, 1), pad = 8;
            function toMini(x, y) {
                return [
                    pad + ((x - minX) / rangeX) * (canvas.width - 2 * pad),
                    pad + ((y - minY) / rangeY) * (canvas.height - 2 * pad)
                ];
            }
            ids.forEach(id => {
                const p = positions[id]; if (!p) return;
                const [mx, my] = toMini(p.x, p.y);
                const nodeObj = nodeIndexMap.get(id);
                ctx.fillStyle = (id === masterHubId) ? "#FF7300" : (nodeObj && nodeObj.color ? (nodeObj.color.background || nodeObj.color) : "#8A8D99");
                ctx.beginPath();
                ctx.arc(mx, my, (id === masterHubId ? 2.5 : 1.5), 0, 2 * Math.PI);
                ctx.fill();
            });

            // Frustum em #FF7300
            try {
                const viewPos = network.getViewPosition();
                const scale = network.getScale();
                const canvasEl = container.querySelector('canvas');
                if (canvasEl && scale > 0) {
                    const viewW = canvasEl.clientWidth / scale;
                    const viewH = canvasEl.clientHeight / scale;
                    const [vx1, vy1] = toMini(viewPos.x - viewW / 2, viewPos.y - viewH / 2);
                    const [vx2, vy2] = toMini(viewPos.x + viewW / 2, viewPos.y + viewH / 2);
                    ctx.strokeStyle = "#FF7300";
                    ctx.fillStyle = "rgba(255,115,0,0.12)";
                    ctx.lineWidth = 1.4;
                    const rw = Math.max(vx2 - vx1, 4), rh = Math.max(vy2 - vy1, 4);
                    ctx.fillRect(vx1, vy1, rw, rh);
                    ctx.strokeRect(vx1, vy1, rw, rh);
                }
            } catch (e) {}
        }

        function toggleTheme() {
            const atual = document.body.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            document.body.setAttribute('data-theme', atual === 'dark' ? '' : 'light');
            temaAtualBg = (atual === 'dark' ? '#161616' : '#FCFCFC');
            document.getElementById('btn-dock-theme').classList.toggle('active', atual === 'light');
            if (network) {
                updateAdaptiveLOD();
                network.redraw();
            }
        }

        function reportarAlturaReal() {
            setFrameHeightStreamlit(window.innerHeight);
        }
        window.addEventListener('resize', reportarAlturaReal);

        function toggleFilterPopover() { const p = document.getElementById('filter-popover'); p.style.display = p.style.display === "none" ? "block" : "none"; }
        function toggleSearchPanel() {
            const p = document.getElementById('search-panel');
            const v = p.style.display !== "none";
            p.style.display = v ? "none" : "block";
            document.getElementById('rail-search').classList.toggle('active', !v);
        }
        function toggleExportMenu() { const m = document.getElementById('export-menu'); m.style.display = m.style.display === "none" ? "flex" : "none"; }

        function exportJSON() {
            toggleExportMenu();
            const alvo = selectedNodesQueue.length > 1
                ? { nodes: rawNodes.filter(n => selectedNodesQueue.includes(n.id)), edges: rawEdges.filter(e => selectedNodesQueue.includes(e.from) && selectedNodesQueue.includes(e.to)) }
                : { nodes: rawNodes, edges: rawEdges };
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(alvo, null, 2));
            const a = document.createElement('a');
            a.href = dataStr; a.download = 'investigacao_grafo.json'; a.click();
        }
        function exportPNG() {
            toggleExportMenu();
            const canvas = container.querySelector('canvas');
            const a = document.createElement('a');
            a.download = 'evidencia_lcfo.png'; a.href = canvas.toDataURL('image/png'); a.click();
        }
        function resetarOuRecalcularLayout() { sendValueToStreamlit({ tipo: "reset_layout_request" }); }
        function zoomIn() { if (network) network.moveTo({ scale: network.getScale() * 1.25, animation: { duration: 250 } }); }
        function zoomOut() { if (network) network.moveTo({ scale: network.getScale() * 0.8, animation: { duration: 250 } }); }
        function fitView() { if (network) network.fit({ animation: { duration: 350 }, padding: 60 }); }

        function aplicarFiltroTipo() {
            const permitidos = new Set();
            ['cpf', 'telefone', 'placa', 'prestador'].forEach(t => { if (document.getElementById('flt-' + t)?.checked) permitidos.add(t); });
            const updates = [];
            nodesDataSet.forEach(node => updates.push({ id: node.id, hidden: !permitidos.has(node.tipo) }));
            nodesDataSet.update(updates);
        }

        function dispararEnrich() {
            if (!currentInspectedNodeId) return;
            const nodeObj = nodeIndexMap.get(currentInspectedNodeId);
            if (!nodeObj) return;
            sendValueToStreamlit({ tipo: "enrich_request", nodeId: currentInspectedNodeId, tipoEntidade: nodeObj.tipo, valor: nodeObj.valor });
        }

        const FLAG_CORES = { red: '#EF4444', orange: '#F97316', blue: '#3B82F6', green: '#22C55E', yellow: '#EAB308' };
        function ctxAplicarFlag(cor) {
            if (!contextMenuNodeId) return;
            const nodeObj = nodeIndexMap.get(contextMenuNodeId);
            const novaCor = nodeObj.flag === cor ? null : cor;
            nodeObj.flag = novaCor;
            nodesDataSet.update({ id: contextMenuNodeId, borderWidth: novaCor ? 4 : (contextMenuNodeId === masterHubId ? 3.5 : 1.2) });
            hideContextMenu();
        }

        function applyHighlight(selectedId) {
            currentHighlightId = selectedId;
            if (!network) return;
            if (selectedId && nodesDataSet.get(selectedId)) {
                const connected = network.getConnectedNodes(selectedId); connected.push(selectedId);
                const updates = [];
                nodesDataSet.forEach(node => updates.push({ id: node.id, opacity: connected.includes(node.id) ? 1.0 : 0.12, borderWidth: (node.id === selectedId ? 3.5 : 1.2) }));
                nodesDataSet.update(updates);
            } else {
                const updates = [];
                nodesDataSet.forEach(node => updates.push({ id: node.id, opacity: 1.0, borderWidth: (node.id === masterHubId ? 3.5 : 1.2) }));
                nodesDataSet.update(updates);
            }
        }

        function limparSelecaoMultipla() { selectedNodesQueue = []; applyHighlight(null); closeDrawer(); }

        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'a') {
                e.preventDefault();
                selectedNodesQueue = [];
                nodesDataSet.forEach(n => { if (!n.hidden) selectedNodesQueue.push(n.id); });
                const updates = selectedNodesQueue.map(id => ({ id, borderWidth: 3.5 }));
                nodesDataSet.update(updates);
            }
        });

        function toggleModoSelecao() {
            modoSelecaoAtivo = !modoSelecaoAtivo;
            document.getElementById('rail-select').classList.toggle('active', modoSelecaoAtivo);
            container.style.cursor = modoSelecaoAtivo ? 'crosshair' : 'default';
        }
        let selRectStart = null;
        container.addEventListener('mousedown', function(e) {
            if (!modoSelecaoAtivo) return;
            const rect = container.getBoundingClientRect();
            selRectStart = { x: e.clientX - rect.left, y: e.clientY - rect.top };
            const el = document.getElementById('select-rect');
            el.style.display = 'block'; el.style.left = selRectStart.x + 'px'; el.style.top = selRectStart.y + 'px';
            el.style.width = '0px'; el.style.height = '0px';
        });
        container.addEventListener('mousemove', function(e) {
            if (!modoSelecaoAtivo || !selRectStart) return;
            const rect = container.getBoundingClientRect();
            const curX = e.clientX - rect.left, curY = e.clientY - rect.top;
            const el = document.getElementById('select-rect');
            el.style.left = Math.min(selRectStart.x, curX) + 'px';
            el.style.top = Math.min(selRectStart.y, curY) + 'px';
            el.style.width = Math.abs(curX - selRectStart.x) + 'px';
            el.style.height = Math.abs(curY - selRectStart.y) + 'px';
        });
        container.addEventListener('mouseup', function(e) {
            if (!modoSelecaoAtivo || !selRectStart) return;
            const rect = container.getBoundingClientRect();
            const curX = e.clientX - rect.left, curY = e.clientY - rect.top;
            const x1 = Math.min(selRectStart.x, curX), x2 = Math.max(selRectStart.x, curX);
            const y1 = Math.min(selRectStart.y, curY), y2 = Math.max(selRectStart.y, curY);
            const positions = network.getPositions();
            const encontrados = [];
            Object.keys(positions).forEach(id => {
                const dom = network.canvasToDOM(positions[id]);
                if (dom.x >= x1 && dom.x <= x2 && dom.y >= y1 && dom.y <= y2) encontrados.push(id);
            });
            selectedNodesQueue = encontrados;
            const updates = [];
            nodesDataSet.forEach(n => updates.push({ id: n.id, borderWidth: encontrados.includes(n.id) ? 3.5 : 1.2 }));
            nodesDataSet.update(updates);
            document.getElementById('select-rect').style.display = 'none';
            selRectStart = null;
        });

        function executarFindPath() {
            if (selectedNodesQueue.length < 2) { alert("Selecione 2 nós antes de usar o Find Path."); return; }
            const startNode = selectedNodesQueue[selectedNodesQueue.length - 2];
            const endNode = selectedNodesQueue[selectedNodesQueue.length - 1];
            const queue = [[startNode]]; const visited = new Set([startNode]); let foundPath = null;
            while (queue.length > 0) {
                const path = queue.shift(); const node = path[path.length - 1];
                if (node === endNode) { foundPath = path; break; }
                (adjacencySimples.get(node) || []).forEach(nx => { if (!visited.has(nx)) { visited.add(nx); queue.push([...path, nx]); } });
            }
            if (!foundPath) { alert("Nenhum caminho relacional localizado."); return; }
            const pathSet = new Set(foundPath);
            const updates = [];
            nodesDataSet.forEach(node => updates.push({ id: node.id, opacity: pathSet.has(node.id) ? 1.0 : 0.10, borderWidth: pathSet.has(node.id) ? 3.5 : 1.0 }));
            nodesDataSet.update(updates);
        }

        function filtrarListaBusca(termo) {
            const resultsEl = document.getElementById('search-results'), clearBtn = document.getElementById('search-clear-btn');
            if (!termo || termo.trim().length < 2) { resultsEl.style.display = "none"; resultsEl.innerHTML = ""; clearBtn.style.display = "none"; return; }
            clearBtn.style.display = "block";
            const termoClean = termo.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
            const encontrados = rawNodes.filter(n => {
                const vClean = (n.valor || "").replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
                const lClean = (n.label || "").replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
                return vClean.includes(termoClean) || lClean.includes(termoClean);
            }).slice(0, 25);
            resultsEl.innerHTML = encontrados.length === 0
                ? "<div style='color:var(--text-muted); font-size:11px; padding:4px;'>Nenhum registro localizado.</div>"
                : "";
            encontrados.forEach(n => {
                const item = document.createElement('div');
                item.className = 'search-result-item'; item.innerText = n.label;
                item.onclick = function() { selectInspectedNode(n.id); };
                resultsEl.appendChild(item);
            });
            resultsEl.style.display = "flex";
        }
        function limparBuscaGrafo() { document.getElementById('search-input').value = ""; filtrarListaBusca(""); }

        function handleContextMenu(params) {
            params.event.preventDefault();
            const nodeId = network.getNodeAt(params.pointer.DOM);
            const menu = document.getElementById('context-menu');
            if (!nodeId) { menu.style.display = "none"; return; }
            contextMenuNodeId = nodeId;
            document.getElementById('ctx-node-title').innerText = nodeIndexMap.get(nodeId)?.label || "Entidade";
            let posX = params.pointer.DOM.x + 8, posY = params.pointer.DOM.y + 8;
            if (posX + 200 > container.clientWidth) posX = params.pointer.DOM.x - 200;
            if (posY + 260 > container.clientHeight) posY = params.pointer.DOM.y - 250;
            menu.style.left = posX + "px"; menu.style.top = posY + "px"; menu.style.display = "block";
        }
        function hideContextMenu() { const menu = document.getElementById('context-menu'); if (menu) menu.style.display = "none"; }
        document.addEventListener("click", hideContextMenu);

        function ctxCopiarDado() { if (!contextMenuNodeId) return; const n = nodeIndexMap.get(contextMenuNodeId); if (n) navigator.clipboard.writeText(n.valor || n.id); hideContextMenu(); }
        function ctxCentralizar() { if (contextMenuNodeId) network.focus(contextMenuNodeId, { scale: 1.15, animation: { duration: 350 } }); hideContextMenu(); }
        function ctxIsolar() { if (contextMenuNodeId) applyHighlight(contextMenuNodeId); hideContextMenu(); }
        function ctxAbrirDrawer() { if (contextMenuNodeId) { openInspector(contextMenuNodeId); applyHighlight(contextMenuNodeId); } hideContextMenu(); }
        function ctxEnrich() { if (contextMenuNodeId) { currentInspectedNodeId = contextMenuNodeId; dispararEnrich(); } hideContextMenu(); }

        function switchDrawerTab(tab) {
            document.querySelectorAll('.drawer-tab').forEach(el => el.classList.toggle('active', el.dataset.tab === tab));
            document.querySelectorAll('.drawer-tab-content').forEach(el => el.classList.toggle('active', el.id === 'tab-' + tab));
        }

        function desenharNeighborsPreview(nodeId, connectedIds) {
            const canvas = document.getElementById('drawer-neighbors-preview'); if (!canvas) return;
            const ctx = canvas.getContext('2d'); ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (!connectedIds || connectedIds.length === 0) return;
            const cx = canvas.width / 2, cy = canvas.height / 2;
            const exibicaoIds = connectedIds.slice(0, 36);
            const raio = Math.min(50, 24 + exibicaoIds.length * 1.1);
            const posicoes = [];
            ctx.strokeStyle = "rgba(184,184,184,0.3)"; ctx.lineWidth = 1;
            exibicaoIds.forEach((id, i) => {
                const ang = (2 * Math.PI * i) / exibicaoIds.length;
                const px = cx + raio * Math.cos(ang), py = cy + raio * Math.sin(ang);
                posicoes.push([px, py]);
                ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(px, py); ctx.stroke();
            });
            exibicaoIds.forEach((id, i) => {
                const nObj = nodeIndexMap.get(id); const [px, py] = posicoes[i];
                ctx.beginPath(); ctx.arc(px, py, 4.5, 0, 2 * Math.PI);
                ctx.fillStyle = nObj && nObj.color ? (nObj.color.background || nObj.color) : "#FF7300"; ctx.fill();
            });
            const centerObj = nodeIndexMap.get(nodeId);
            ctx.beginPath(); ctx.arc(cx, cy, 7.5, 0, 2 * Math.PI);
            ctx.fillStyle = centerObj && centerObj.color ? (centerObj.color.background || centerObj.color) : "#FF7300"; ctx.fill();
            ctx.strokeStyle = "#FF7300"; ctx.lineWidth = 1.8; ctx.stroke();
        }

        function openInspector(nodeId) {
            const nodeObj = nodeIndexMap.get(nodeId); if (!nodeObj) return;
            currentInspectedNodeId = nodeId;
            const drawer = document.getElementById('inspector-drawer');
            const badge = document.getElementById('drawer-badge'), rowNome = document.getElementById('drawer-row-nome');
            badge.innerText = (nodeObj.tipo || "ENTIDADE").toUpperCase();
            badge.style.background = nodeObj.color ? (nodeObj.color.background || nodeObj.color) : "#3C6FA8";
            badge.style.color = "#FFFFFF";
            document.getElementById('drawer-title').innerText = nodeObj.label;
            document.getElementById('drawer-val').innerText = nodeObj.valor || nodeObj.id;
            document.getElementById('drawer-degree').innerText = `${nodeObj.degree || 1} conexão(ões)`;
            document.getElementById('drawer-betweenness').innerText = nodeObj.betweenness !== undefined ? `${nodeObj.betweenness}` : '0.0';
            document.getElementById('drawer-community').innerText = nodeObj.community !== undefined ? `Grupo #${nodeObj.community}` : 'Principal';
            if (nodeObj.tipo === "cpf" && nodeObj.nome_titular) { rowNome.style.display = "flex"; document.getElementById('drawer-nome').innerText = nodeObj.nome_titular; }
            else { rowNome.style.display = "none"; }
            switchDrawerTab('details');

            const vizinhos = adjacencyMap.get(nodeId) || [];
            desenharNeighborsPreview(nodeId, vizinhos.map(v => v.id));
            const listEl = document.getElementById('drawer-neighbors-list'); listEl.innerHTML = "";
            vizinhos.slice(0, 35).forEach(nb => {
                const nbObj = nodeIndexMap.get(nb.id); if (!nbObj) return;
                const item = document.createElement('div');
                item.className = 'neighbor-item';
                item.onclick = function() { selectInspectedNode(nb.id); };
                item.innerHTML = `<span>${nbObj.label}</span><span style="color:var(--primary); font-size:9px;">${nb.title}</span>`;
                listEl.appendChild(item);
            });

            // ABA RELATIONS (PILULAS COLORIDAS NO PADRÃO FLOWSINT)
            const relListEl = document.getElementById('drawer-relations-list');
            if (relListEl) {
                relListEl.innerHTML = "";
                const arestasDoNo = rawEdges.filter(e => e.from === nodeId || e.to === nodeId);

                if (arestasDoNo.length === 0) {
                    relListEl.innerHTML = "<div style='color:var(--text-muted); font-size:11px; padding:6px;'>Nenhum vínculo catalogado.</div>";
                } else {
                    arestasDoNo.forEach(edge => {
                        const sourceNode = nodeIndexMap.get(edge.from);
                        const targetNode = nodeIndexMap.get(edge.to);
                        if (!sourceNode || !targetNode) return;

                        const labelAresta = edge.title ? edge.title.replace('Vínculo relacional: ', '') : (edge.label || 'RELATED_TO');
                        const sColor = sourceNode.color ? (sourceNode.color.border || sourceNode.color.background || sourceNode.color) : "#3C6FA8";
                        const tColor = targetNode.color ? (targetNode.color.border || targetNode.color.background || targetNode.color) : "#6BA57D";

                        const row = document.createElement('div');
                        row.style.display = 'flex';
                        row.style.alignItems = 'center';
                        row.style.justifyContent = 'space-between';
                        row.style.background = 'rgba(255, 255, 255, 0.02)';
                        row.style.border = '1px solid var(--border)';
                        row.style.borderRadius = '6px';
                        row.style.padding = '8px 10px';
                        row.style.fontSize = '11px';

                        row.innerHTML = `
                            <span style="background:${sColor}26; color:${sColor}; border:1px solid ${sColor}55; padding:3px 8px; border-radius:4px; font-weight:700; max-width:105px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                ${sourceNode.label}
                            </span>
                            <span style="color:var(--text-muted); font-size:10px; font-weight:700; letter-spacing:0.5px; padding:0 6px;">
                                &rarr; &nbsp; ${labelAresta} &nbsp; &rarr;
                            </span>
                            <span style="background:${tColor}26; color:${tColor}; border:1px solid ${tColor}55; padding:3px 8px; border-radius:4px; font-weight:700; max-width:105px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                ${targetNode.label}
                            </span>
                        `;
                        relListEl.appendChild(row);
                    });
                }
            }

            drawer.classList.add('open');
        }
        function closeDrawer() { document.getElementById('inspector-drawer').classList.remove('open'); currentInspectedNodeId = null; }
        function selectInspectedNode(nodeId) { openInspector(nodeId); applyHighlight(nodeId); if (network) network.focus(nodeId, { scale: 1.15, animation: { duration: 400 } }); }

        (function initDrawerResize() {
            const handleH = document.getElementById('drawer-resize-handle');
            const drawer = document.getElementById('inspector-drawer');
            let resizing = false;
            handleH.addEventListener('mousedown', function(e) { resizing = true; document.body.style.userSelect = 'none'; e.preventDefault(); });
            document.addEventListener('mousemove', function(e) { if (resizing) drawer.style.width = Math.min(640, Math.max(300, window.innerWidth - e.clientX)) + "px"; });
            document.addEventListener('mouseup', function() { resizing = false; document.body.style.userSelect = ''; });
        })();

        function marcarLayoutAtivo(mode) {
            ['organico', 'arvore'].forEach(m => { const el = document.getElementById(`rail-${m}`); if (el) el.classList.toggle('active', m === mode); });
        }

        // --- ARESTAS COM SETAS DIRECIONAIS E CORES HERDADAS DO NÓ CONECTADO ---
        function aplicarCurvaturaECoresArestas(edges) {
            const grupos = new Map();
            edges.forEach(e => {
                const chave = [e.from, e.to].sort().join('__');
                if (!grupos.has(chave)) grupos.set(chave, []);
                grupos.get(chave).push(e);
            });

            grupos.forEach(grupo => {
                const total = grupo.length;
                grupo.forEach((e, i) => {
                    // Curvatura simétrica
                    if (total <= 1) {
                        e.smooth = false;
                    } else {
                        const roundness = (i - (total - 1) / 2) * 0.22;
                        e.smooth = {
                            enabled: true,
                            type: 'curvedCW',
                            roundness: Math.abs(roundness) < 0.001 ? 0 : roundness
                        };
                    }

                    // Aresta herda a cor do nó de destino
                    const targetNode = nodeIndexMap.get(e.to);
                    const sourceNode = nodeIndexMap.get(e.from);
                    let corAresta = "rgba(140, 140, 140, 0.45)";

                    if (targetNode && targetNode.color) {
                        corAresta = (targetNode.color.border || targetNode.color.background || targetNode.color) + "99";
                    } else if (sourceNode && sourceNode.color) {
                        corAresta = (sourceNode.color.border || sourceNode.color.background || sourceNode.color) + "99";
                    }

                    e.color = {
                        color: corAresta,
                        highlight: '#FF7300',
                        hover: '#FF7300',
                        inherit: false,
                        opacity: 0.80
                    };

                    // Seta direcional apontando para o destino
                    e.arrows = {
                        to: {
                            enabled: true,
                            scaleFactor: 0.65,
                            type: 'arrow'
                        }
                    };
                });
            });
        }

        // =====================================================================
        // CONTROLE DO MODAL DE CONFIRMAÇÃO DO LAYOUT HIERÁRQUICO
        // =====================================================================
        function solicitarHierarchyLayout() {
            document.getElementById('modal-confirm-hierarchy').style.display = 'flex';
        }

        function fecharModalHierarchy() {
            document.getElementById('modal-confirm-hierarchy').style.display = 'none';
        }

        function confirmarHierarchyLayout() {
            fecharModalHierarchy();
            changeLayout('arvore');
        }

        // =====================================================================
        // LAYOUTS DETERMINÍSTICOS: FÍSICA ESTRITAMENTE DESATIVADA (SEM GIROS)
        // =====================================================================
        function changeLayout(mode) {
            marcarLayoutAtivo(mode);
            if (!network) return;

            // Bloqueio rigoroso de simulação contínua
            network.setOptions({ physics: { enabled: false } });

            if (mode === "organico") {
                // Restaura posições orbitais estáticas salvas
                const updates = rawNodes.filter(n => n.x !== undefined && n.y !== undefined).map(n => ({
                    id: n.id,
                    x: n.x,
                    y: n.y
                }));
                nodesDataSet.update(updates);
                setTimeout(() => { fitView(); updateAdaptiveLOD(); if (currentHighlightId) applyHighlight(currentHighlightId); }, 40);
            } else if (mode === "arvore") {
                // Algoritmo Hierárquico Compactado em Grid para Redes Densas (+1200 nós)
                const levels = new Map();
                const queue = [{ id: masterHubId || rawNodes[0]?.id, lvl: 0 }];
                levels.set(queue[0].id, 0);

                while (queue.length > 0) {
                    const curr = queue.shift();
                    (adjacencySimples.get(curr.id) || []).forEach(nbr => {
                        if (!levels.has(nbr)) {
                            levels.set(nbr, curr.lvl + 1);
                            queue.push({ id: nbr, lvl: curr.lvl + 1 });
                        }
                    });
                }

                // Agrupa nós por nível
                const levelGroups = new Map();
                rawNodes.forEach(n => {
                    const l = levels.get(n.id) ?? 1;
                    if (!levelGroups.has(l)) levelGroups.set(l, []);
                    levelGroups.get(l).push(n.id);
                });

                const updates = [];
                let currentY = -180;
                const maxLevel = Math.max(...Array.from(levelGroups.keys()), 0);

                for (let lvl = 0; lvl <= maxLevel; lvl++) {
                    const nodeIds = levelGroups.get(lvl) || [];
                    if (nodeIds.length === 0) continue;

                    if (lvl === 0) {
                        // Hub / Raiz Central
                        nodeIds.forEach(id => {
                            updates.push({ id, x: 0, y: currentY });
                        });
                        currentY += 160;
                    } else {
                        // Empacotamento inteligente em matriz (máx 22 colunas) para evitar linhas de 140.000px
                        const count = nodeIds.length;
                        const cols = count <= 12 ? count : Math.min(22, Math.max(8, Math.ceil(Math.sqrt(count * 1.4))));
                        const rows = Math.ceil(count / cols);
                        const colSpacing = 160;
                        const rowSpacing = 80;

                        for (let r = 0; r < rows; r++) {
                            const rowNodes = nodeIds.slice(r * cols, (r + 1) * cols);
                            const rowWidth = (rowNodes.length - 1) * colSpacing;
                            const startX = -rowWidth / 2;

                            rowNodes.forEach((id, c) => {
                                updates.push({
                                    id,
                                    x: Math.round(startX + c * colSpacing),
                                    y: Math.round(currentY + r * rowSpacing)
                                });
                            });
                        }
                        currentY += (rows * rowSpacing) + 140;
                    }
                }

                nodesDataSet.update(updates);
                setTimeout(() => { fitView(); updateAdaptiveLOD(); if (currentHighlightId) applyHighlight(currentHighlightId); }, 40);
            }
        }

        function posicionarNosOrbitalmente(novosNos) {
            const semPosicao = novosNos.filter(n => n.x === undefined || n.y === undefined);
            if (semPosicao.length === 0) return;
            const grupos = new Map();
            semPosicao.forEach(n => {
                const pai = n.orbit_ao_redor || masterHubId;
                if (!grupos.has(pai)) grupos.set(pai, []);
                grupos.get(pai).push(n);
            });
            grupos.forEach((grupo, paiId) => {
                let posPai = { x: 0, y: 0 };
                if (network) { const pe = network.getPositions([paiId]); if (pe[paiId]) posPai = pe[paiId]; }
                const raio = Math.max(130, grupo.length * 22);
                grupo.forEach((n, i) => {
                    const angle = (2 * Math.PI * i) / Math.max(grupo.length, 1);
                    n.x = Math.round(posPai.x + raio * Math.cos(angle));
                    n.y = Math.round(posPai.y + raio * Math.sin(angle));
                });
            });
        }

        function criarNetwork() {
            network = new vis.Network(container, { nodes: nodesDataSet, edges: edgesDataSet }, {
                physics: { enabled: false },
                interaction: { hover: true, zoomView: true, dragNodes: true, tooltipDelay: 100 }
            });

            network.on("beforeDrawing", desenharGridPontilhado);
            network.on("afterDrawing", desenharMinimapa);
            network.on("zoom", function() {
                updateAdaptiveLOD();
                desenharMinimapa();
            });
            network.on("dragEnd", function() {
                desenharMinimapa();
            });
            network.on("oncontext", handleContextMenu);
            network.on("dragStart", hideContextMenu);
            network.on("click", function(params) {
                if (modoSelecaoAtivo) return;
                if (params.nodes.length > 0) {
                    const clickedId = params.nodes[0];
                    selectedNodesQueue.push(clickedId);
                    if (selectedNodesQueue.length > 6) selectedNodesQueue.shift();
                    applyHighlight(clickedId);
                    openInspector(clickedId);
                    sendValueToStreamlit({ tipo: "node_click", nodeId: clickedId });
                } else { applyHighlight(null); closeDrawer(); }
            });
            network.on("hoverNode", function(params) {
                if (currentHighlightId) return;
                const connected = network.getConnectedNodes(params.node); connected.push(params.node);
                const updates = [];
                nodesDataSet.forEach(n => updates.push({ id: n.id, opacity: connected.includes(n.id) ? 1.0 : 0.35 }));
                nodesDataSet.update(updates);
            });
            network.on("blurNode", function() {
                if (currentHighlightId) return;
                const updates = []; nodesDataSet.forEach(n => updates.push({ id: n.id, opacity: 1.0 })); nodesDataSet.update(updates);
            });
        }

        function inicializarOuAtualizarRede(novosDados) {
            const assinaturaNova = JSON.stringify({ n: (novosDados.nodes || []).length, e: (novosDados.edges || []).length, h: novosDados.hub_id, l: novosDados.layout_ativo });
            const mudouEstrutura = assinaturaNova !== assinaturaDadosAtual || !network;
            baseFontSize = novosDados.base_font_size || 11;
            targetSearchId = novosDados.target_node_id || "";

            if (!mudouEstrutura) {
                assinaturaDadosAtual = assinaturaNova;
                if (targetSearchId && nodeIndexMap.has(targetSearchId)) selectInspectedNode(targetSearchId);
                reportarAlturaReal();
                return;
            }

            assinaturaDadosAtual = assinaturaNova;
            rawNodes = novosDados.nodes || [];
            rawEdges = novosDados.edges || [];
            masterHubId = novosDados.hub_id || "";
            initialLayout = novosDados.layout_ativo || "organico";

            posicionarNosOrbitalmente(rawNodes);
            nodeIndexMap = new Map(rawNodes.map(n => [n.id, n]));
            aplicarCurvaturaECoresArestas(rawEdges);

            adjacencyMap = new Map(); adjacencySimples = new Map();
            rawNodes.forEach(n => { adjacencyMap.set(n.id, []); adjacencySimples.set(n.id, []); });
            rawEdges.forEach(e => {
                const title = e.title ? e.title.replace('Vínculo relacional: ', '') : 'Conexão';
                if (adjacencyMap.has(e.from)) adjacencyMap.get(e.from).push({ id: e.to, title });
                if (adjacencyMap.has(e.to)) adjacencyMap.get(e.to).push({ id: e.from, title });
                if (adjacencySimples.has(e.from)) adjacencySimples.get(e.from).push(e.to);
                if (adjacencySimples.has(e.to)) adjacencySimples.get(e.to).push(e.from);
            });

            nodesDataSet.clear(); edgesDataSet.clear();
            nodesDataSet.add(rawNodes); edgesDataSet.add(rawEdges);

            if (!network) criarNetwork();

            setTimeout(function() {
                if (initialLayout && initialLayout !== "organico") changeLayout(initialLayout);
                else { marcarLayoutAtivo("organico"); fitView(); }
                if (targetSearchId && nodeIndexMap.has(targetSearchId)) selectInspectedNode(targetSearchId);
                updateAdaptiveLOD();
                reportarAlturaReal();
            }, 60);
        }

        window.addEventListener("message", function(event) {
            if (!event.data || event.data.type !== "streamlit:render") return;
            inicializarOuAtualizarRede(event.data.args || {});
        });

        notifyReadyStreamlit();
    </script>
