<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>LCFO Grafo Bidirecional</title>
    <script type="text/javascript" src="vis-network.min.js"></script>
    <script type="text/javascript">
        if (typeof vis === "undefined") {
            document.write('<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/vis-network/9.1.9/standalone/umd/vis-network.min.js"><\/script>');
        }
    </script>
    <style>
        :root {
            --bg: #161616; --surface: #1F1F1F; --card: #232323; --card-glass: rgba(31, 31, 31, 0.90);
            --border: #2C2C2C; --text: #EDEDED; --text-muted: #888888; --primary: #FF7300;
            --canvas-accent: #FF7300;
        }
        [data-theme="light"] {
            --bg: #FCFCFC; --surface: #FCFCFC; --card: #FFFFFF; --card-glass: rgba(255, 255, 255, 0.90);
            --border: #DADCE3; --text: #454545; --text-muted: #8A8D99; --primary: #FF7300;
            --canvas-accent: #FF7300;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        html, body { background: var(--bg); overflow: hidden; width: 100%; height: 100%; position: relative; }
        #network { width: 100%; height: 100%; background-color: var(--bg); }

        .top-dock {
            position: absolute; top: 10px; left: 50%; transform: translateX(-50%); z-index: 30;
            display: flex; align-items: center; gap: 4px; background: var(--card-glass);
            border: 1px solid var(--border); border-radius: 8px; padding: 4px 6px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.4); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        .dock-btn {
            background: transparent; border: none; color: var(--text-muted); width: 32px; height: 30px;
            border-radius: 6px; display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: 0.15s; outline: none;
        }
        .dock-btn:hover { background: var(--surface); color: var(--text); }
        .dock-btn.active { background: var(--primary); color: #FFFFFF; }

        .top-right-controls {
            position: absolute; top: 10px; right: 14px; z-index: 30;
            display: flex; align-items: center; gap: 4px; background: var(--card-glass);
            border: 1px solid var(--border); border-radius: 8px; padding: 4px 6px;
            backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        .tr-btn {
            background: transparent; border: none; color: var(--text-muted); width: 30px; height: 28px;
            border-radius: 5px; display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: 0.15s; position: relative; outline: none;
        }
        .tr-btn:hover { background: var(--surface); color: var(--text); }
        .export-menu {
            position: absolute; top: 36px; right: 0; width: 150px; background: var(--card-glass);
            border: 1px solid var(--border); border-radius: 6px; padding: 4px; box-shadow: 0 6px 20px rgba(0,0,0,0.4);
            display: flex; flex-direction: column; gap: 2px; z-index: 50;
            backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        .export-item { padding: 6px 10px; font-size: 11px; color: var(--text); cursor: pointer; border-radius: 4px; }
        .export-item:hover { background: var(--primary); color: #FFFFFF; }

        .bottom-left-controls {
            position: absolute; bottom: 14px; left: 14px; z-index: 30;
            display: flex; align-items: center; gap: 4px; background: var(--card-glass);
            border: 1px solid var(--border); border-radius: 8px; padding: 4px 6px;
            backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        .bl-btn {
            background: transparent; border: none; color: var(--text-muted); width: 30px; height: 28px;
            border-radius: 5px; display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: 0.15s; outline: none;
        }
        .bl-btn:hover { background: var(--surface); color: var(--primary); }

        .left-rail {
            position: absolute; top: 54px; left: 14px; z-index: 25;
            display: flex; flex-direction: column; gap: 4px; background: var(--card-glass);
            border: 1px solid var(--border); border-radius: 8px; padding: 6px 4px;
            backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        .rail-btn {
            background: transparent; border: none; color: var(--text-muted); width: 32px; height: 30px;
            border-radius: 6px; display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: 0.15s; outline: none;
        }
        .rail-btn:hover { background: var(--surface); color: var(--primary); }
        .rail-btn.active { background: var(--primary); color: #FFFFFF; }
        .rail-separator { width: 20px; height: 1px; background: var(--border); margin: 3px auto; }

        .search-panel {
            position: absolute; top: 54px; left: 60px; z-index: 25; width: 210px;
            background: var(--card-glass); border: 1px solid var(--border);
            border-radius: 6px; padding: 6px; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        .search-input-wrap { position: relative; display: flex; align-items: center; }
        .search-panel input {
            width: 100%; background: var(--surface); border: 1px solid var(--border); color: var(--text);
            padding: 6px 24px 6px 8px; border-radius: 4px; font-size: 11px; outline: none;
        }
        .search-panel input:focus { border-color: var(--primary); }
        .search-clear-btn {
            position: absolute; right: 6px; background: transparent; border: none;
            color: var(--text-muted); cursor: pointer; font-size: 14px; display: none; line-height: 1;
        }
        .search-results { overflow-y: auto; max-height: 220px; display: flex; flex-direction: column; gap: 4px; margin-top: 6px; }
        .search-result-item {
            background: var(--surface); border: 1px solid var(--border); padding: 6px 8px;
            border-radius: 4px; font-size: 11px; color: var(--text); cursor: pointer;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .search-result-item:hover { border-color: var(--primary); color: var(--primary); }

        .minimap-container {
            position: absolute; bottom: 14px; right: 14px; z-index: 20;
            background: var(--card-glass); border: 1px solid var(--border);
            border-radius: 6px; padding: 4px; pointer-events: none;
            backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        #minimap-canvas { display: block; border-radius: 3px; }

        .context-menu {
            position: absolute; display: none; z-index: 100;
            background: var(--card-glass); border: 1px solid var(--border); border-radius: 6px;
            padding: 4px; min-width: 190px; box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        .context-menu-header {
            padding: 6px 10px 4px 10px; font-size: 10px; font-weight: 700; color: var(--text-muted);
            text-transform: uppercase; border-bottom: 1px solid var(--border); margin-bottom: 4px;
        }
        .context-menu-item {
            padding: 7px 10px; font-size: 11px; color: var(--text); cursor: pointer;
            border-radius: 4px; font-weight: 600;
        }
        .context-menu-item:hover { background: var(--primary); color: #FFFFFF; }
        .context-flags { display: flex; gap: 4px; padding: 6px 8px; }
        .flag-dot {
            width: 16px; height: 16px; border-radius: 50%; cursor: pointer; border: 2px solid transparent;
        }
        .flag-dot:hover { border-color: var(--text); }

        /* =====================================================================
           DRAWER FLOWSINT COM ABAS PROPERTIES / NEIGHBORS / RELATIONS
           ===================================================================== */
        .drawer {
            position: absolute; top: 0; right: 0; width: 370px; height: 100%;
            background: var(--card-glass); border-left: 1px solid var(--border);
            box-shadow: -10px 0 30px rgba(0,0,0,0.5); z-index: 50; display: flex; flex-direction: column;
            transform: translateX(100%); transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            color: var(--text); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        }
        .drawer.open { transform: translateX(0); }
        .drawer-resize-handle {
            position: absolute; left: -4px; top: 0; width: 8px; height: 100%; cursor: ew-resize; z-index: 60;
        }
        .drawer-header {
            padding: 12px 16px; display: flex; align-items: center; justify-content: space-between;
            border-bottom: 1px solid var(--border);
        }
        .drawer-close-btn { background: transparent; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer; }
        .drawer-badge { font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; }
        .drawer-tabs { display: flex; border-bottom: 1px solid var(--border); }
        .drawer-tab {
            flex: 1; padding: 9px; text-align: center; font-size: 11px; font-weight: 600;
            color: var(--text-muted); cursor: pointer; border-bottom: 2px solid transparent;
            transition: color 0.15s, border-bottom-color 0.15s;
        }
        .drawer-tab.active { color: var(--primary); border-bottom-color: var(--primary); }
        .drawer-tab-content { display: none; flex: 1; overflow-y: auto; padding: 14px 16px; }
        .drawer-tab-content.active { display: block; }
        .drawer-section { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; }
        .drawer-field { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 12px; }
        .drawer-field:last-child { border-bottom: none; }
        .field-label { color: var(--text-muted); }
        .field-value { color: var(--text); font-weight: 600; text-align: right; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .enrich-cta-btn {
            margin: 12px 16px 6px 16px; background: var(--primary); border: none;
            color: #FFFFFF; padding: 8px 12px; border-radius: 6px; font-weight: 700;
            font-size: 11px; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer;
        }
        .neighbors-preview-wrap { display: flex; justify-content: center; margin: 8px 0; }
        .neighbor-item {
            display: flex; align-items: center; justify-content: space-between;
            background: var(--surface); border: 1px solid var(--border); padding: 8px 10px;
            border-radius: 5px; cursor: pointer; font-size: 11px; margin-bottom: 6px;
        }
        .neighbor-item:hover { border-color: var(--primary); }

        .select-rect {
            position: absolute; border: 1.5px dashed var(--canvas-accent); background: rgba(255,115,0,0.1);
            z-index: 15; pointer-events: none; display: none;
        }

        /* =====================================================================
           MODAL DE CONFIRMAÇÃO: APPLY HIERARCHY LAYOUT? (IMAGEM 5)
           ===================================================================== */
        .modal-backdrop {
            position: absolute; inset: 0; background: rgba(0, 0, 0, 0.65);
            backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
            z-index: 1000; display: flex; align-items: center; justify-content: center;
        }
        .modal-card {
            background: #1F1F1F; border: 1px solid #333333; border-radius: 8px;
            box-shadow: 0 12px 36px rgba(0,0,0,0.7); width: 380px; padding: 18px 20px;
            display: flex; flex-direction: column;
        }
        .modal-header {
            display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;
        }
        .modal-title {
            font-size: 15px; font-weight: 700; color: #EDEDED;
        }
        .modal-close {
            background: transparent; border: none; color: #888888; font-size: 18px; cursor: pointer;
        }
        .modal-close:hover { color: #EDEDED; }
        .modal-body {
            font-size: 12px; color: #AAAAAA; line-height: 1.5; margin-bottom: 18px;
        }
        .modal-footer {
            display: flex; justify-content: flex-end; gap: 8px;
        }
        .modal-btn-cancel {
            background: transparent; border: 1px solid #444444; border-radius: 6px;
            color: #EDEDED; padding: 6px 16px; font-size: 12px; font-weight: 600; cursor: pointer;
        }
        .modal-btn-cancel:hover { background: #2A2A2A; border-color: #555555; }
        .modal-btn-continue {
            background: #FF7300; border: none; border-radius: 6px;
            color: #FFFFFF; padding: 6px 16px; font-size: 12px; font-weight: 600; cursor: pointer;
        }
        .modal-btn-continue:hover { background: #E0670A; }
    </style>
</head>
<body>
    <div class="top-dock">
        <button class="dock-btn active" id="btn-dock-filter" onclick="toggleFilterPopover()" title="Filtrar Tipos de Entidade">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        </button>
        <button class="dock-btn" id="btn-dock-theme" onclick="toggleTheme()" title="Alternar Tema Claro/Escuro">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
    </div>

    <div id="filter-popover" class="search-panel" style="display:none; top:54px; left:50%; transform:translateX(-50%); width:220px;">
        <div style="font-size:12px; font-weight:700; margin-bottom:6px;">Filtros</div>
        <label style="display:flex; align-items:center; gap:8px; font-size:12px; margin-bottom:6px; cursor:pointer;"><input type="checkbox" id="flt-cpf" checked onchange="aplicarFiltroTipo()"> titular (cpf)</label>
        <label style="display:flex; align-items:center; gap:8px; font-size:12px; margin-bottom:6px; cursor:pointer;"><input type="checkbox" id="flt-telefone" checked onchange="aplicarFiltroTipo()"> telefone</label>
        <label style="display:flex; align-items:center; gap:8px; font-size:12px; margin-bottom:6px; cursor:pointer;"><input type="checkbox" id="flt-placa" checked onchange="aplicarFiltroTipo()"> placa</label>
        <label style="display:flex; align-items:center; gap:8px; font-size:12px; cursor:pointer;"><input type="checkbox" id="flt-prestador" checked onchange="aplicarFiltroTipo()"> prestador</label>
    </div>

    <div class="top-right-controls">
        <div style="position:relative;">
            <button class="tr-btn" onclick="toggleExportMenu()" title="Exportar">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </button>
            <div id="export-menu" class="export-menu" style="display:none;">
                <div class="export-item" onclick="exportJSON()">Exportar como JSON</div>
                <div class="export-item" onclick="exportPNG()">Exportar como PNG</div>
            </div>
        </div>
        <button class="tr-btn" onclick="resetarOuRecalcularLayout()" title="Recalcular Layout">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        </button>
    </div>

    <div class="left-rail">
        <button class="rail-btn" onclick="limparSelecaoMultipla()" title="Limpar Seleção">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </button>
        <button class="rail-btn" id="rail-select" onclick="toggleModoSelecao()" title="Seleção por Retângulo">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3"><rect x="3" y="3" width="18" height="18" rx="1"/></svg>
        </button>
        <button class="rail-btn" onclick="executarFindPath()" title="Find Path (2 nós selecionados)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="19" r="3"/><circle cx="18" cy="5" r="3"/><path d="M6 16v-3a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v2"/></svg>
        </button>
        <button class="rail-btn" id="rail-search" onclick="toggleSearchPanel()" title="Buscar Entidade">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <div class="rail-separator"></div>
        <button class="rail-btn active" id="rail-organico" onclick="changeLayout('organico')" title="Força Orgânica">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><path d="M12 9V5m0 14v-4m-3-3H5m14 0h-4"/></svg>
        </button>
        <!-- Dispara o modal de confirmação no padrão Flowsint -->
        <button class="rail-btn" id="rail-arvore" onclick="solicitarHierarchyLayout()" title="Hierarquia (Tree)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="3" width="6" height="4" rx="1"/><rect x="4" y="17" width="6" height="4" rx="1"/><rect x="14" y="17" width="6" height="4" rx="1"/><path d="M12 7v5m-5 5v-2a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v2"/></svg>
        </button>
    </div>

    <div id="search-panel" class="search-panel" style="display:none;">
        <div class="search-input-wrap">
            <input type="text" id="search-input" placeholder="Buscar..." oninput="filtrarListaBusca(this.value)">
            <button id="search-clear-btn" class="search-clear-btn" onclick="limparBuscaGrafo()">&times;</button>
        </div>
        <div id="search-results" class="search-results" style="display:none;"></div>
    </div>

    <div class="bottom-left-controls">
        <button class="bl-btn" onclick="zoomIn()" title="Zoom In">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        </button>
        <button class="bl-btn" onclick="zoomOut()" title="Zoom Out">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        </button>
        <button class="bl-btn" onclick="fitView()" title="Enquadrar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
        </button>
    </div>

    <div id="minimap-container" class="minimap-container">
        <canvas id="minimap-canvas" width="150" height="105"></canvas>
    </div>

    <div id="context-menu" class="context-menu">
        <div class="context-menu-header" id="ctx-node-title">Entidade</div>
        <div class="context-menu-item" onclick="ctxCopiarDado()">Copiar Identificador</div>
        <div class="context-menu-item" onclick="ctxCentralizar()">Focar no Canvas</div>
        <div class="context-menu-item" onclick="ctxIsolar()">Isolar Vizinhança</div>
        <div class="context-menu-item" onclick="ctxAbrirDrawer()">Inspecionar Atributos</div>
        <div class="context-menu-item" onclick="ctxEnrich()" style="color:var(--primary);">Enriquecer Vínculos</div>
        <div class="context-menu-header" style="border-top:1px solid var(--border); margin-top:4px;">Flag</div>
        <div class="context-flags">
            <div class="flag-dot" style="background:#EF4444;" onclick="ctxAplicarFlag('red')"></div>
            <div class="flag-dot" style="background:#F97316;" onclick="ctxAplicarFlag('orange')"></div>
            <div class="flag-dot" style="background:#3B82F6;" onclick="ctxAplicarFlag('blue')"></div>
            <div class="flag-dot" style="background:#22C55E;" onclick="ctxAplicarFlag('green')"></div>
            <div class="flag-dot" style="background:#EAB308;" onclick="ctxAplicarFlag('yellow')"></div>
        </div>
    </div>

    <div id="network"></div>
    <div id="select-rect" class="select-rect"></div>

    <!-- MODAL DE CONFIRMAÇÃO DO LAYOUT HIERÁRQUICO (IMAGEM 5) -->
    <div id="modal-confirm-hierarchy" class="modal-backdrop" style="display:none;">
        <div class="modal-card">
            <div class="modal-header">
                <span class="modal-title">Apply hierarchy layout?</span>
                <button class="modal-close" onclick="fecharModalHierarchy()">&times;</button>
            </div>
            <div class="modal-body">
                This will reset all node positions and regenerate them using the hierarchical layout algorithm. Current positions will be lost.
            </div>
            <div class="modal-footer">
                <button class="modal-btn-cancel" onclick="fecharModalHierarchy()">Cancel</button>
                <button class="modal-btn-continue" onclick="confirmarHierarchyLayout()">Continue</button>
            </div>
        </div>
    </div>

    <!-- DRAWER COM ABAS PROPERTIES / NEIGHBORS / RELATIONS -->
    <div id="inspector-drawer" class="drawer">
        <div id="drawer-resize-handle" class="drawer-resize-handle" title="Arraste para ajustar largura"></div>
        <div class="drawer-header">
            <div style="display:flex; align-items:center; gap:8px;">
                <span id="drawer-badge" class="drawer-badge"></span>
                <span id="drawer-title" style="font-weight:700; font-size:13px; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
            </div>
            <button class="drawer-close-btn" onclick="closeDrawer()">&times;</button>
        </div>
        <div class="drawer-tabs">
            <div class="drawer-tab active" data-tab="details" onclick="switchDrawerTab('details')">Properties</div>
            <div class="drawer-tab" data-tab="neighbors" onclick="switchDrawerTab('neighbors')">Neighbors</div>
            <div class="drawer-tab" data-tab="relations" onclick="switchDrawerTab('relations')">Relations</div>
        </div>
        <div id="tab-details" class="drawer-tab-content active">
