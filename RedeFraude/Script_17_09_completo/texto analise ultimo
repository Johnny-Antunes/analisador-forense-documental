5. Código

A decisão central pode ser representada da seguinte forma:

def interpretar_data_me(valor: str) -> dict[str, object]:
    """
    Corrige o ano 0025 para 2025 e trata apenas o horário
    00:00:00 como não informado.
    """
    valor_original = str(valor or "").strip()

    if not valor_original:
        return {
            "data": None,
            "hora": None,
            "ano_corrigido": False,
            "horario_informado": False,
        }

    valor_corrigido = valor_original

    if valor_corrigido.startswith("0025-"):
        valor_corrigido = "2025-" + valor_corrigido[5:]
        ano_corrigido = True
    else:
        ano_corrigido = False

    data_texto, _, hora_texto = valor_corrigido.partition(" ")

    horario_ausente = hora_texto.replace(":", "") == "000000"

    return {
        "data": data_texto,
        "hora": None if horario_ausente else hora_texto or None,
        "ano_corrigido": ano_corrigido,
        "horario_informado": bool(hora_texto) and not horario_ausente,
    }


