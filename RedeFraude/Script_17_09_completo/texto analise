def test_corrige_ano_e_remove_horario_tecnico() -> None:
    resultado = normalizar_data_operacional(
        "0025-12-31 00:00:00",
        OrigemArquivo.ME_DATA,
        horario_zerado_representa_ausencia=True,
    )

    assert resultado.data_evento == date(2025, 12, 31)
    assert resultado.hora_evento is None
    assert resultado.timestamp_evento is None
    assert resultado.ano_corrigido is True
    assert resultado.horario_informado is False


def test_preserva_horario_real_do_relatorio() -> None:
    resultado = normalizar_data_operacional(
        "2026-08-31 03:25:17",
        OrigemArquivo.RELATORIO_ASSISTENCIAS,
    )

    assert resultado.timestamp_evento == datetime(
        2026, 8, 31, 3, 25, 17
    )
    assert resultado.horario_informado is True


def test_nao_fabrica_horario_em_data_sem_hora() -> None:
    resultado = normalizar_data_operacional(
        "0025-12-31",
        OrigemArquivo.ME_DATA,
    )

    assert resultado.data_evento == date(2025, 12, 31)
    assert resultado.hora_evento is None
    assert resultado.timestamp_evento is None


def test_rejeita_data_calendario_invalida() -> None:
    resultado = normalizar_data_operacional(
        "0025-02-31 00:00:00",
        OrigemArquivo.ME_DATA,
        horario_zerado_representa_ausencia=True,
    )

    assert resultado.data_evento is None
    assert resultado.precisao == PrecisaoTemporal.DATA_INVALIDA

Regra final consolidada
"0025-12-31 00:00:00"

Ano 0025:
    corrigir para 2025

Data 31/12/2025:
    válida e utilizável

Horário 00:00:00:
    ausente/não informado no contexto desses campos do ME

Análise diária:
    permitida

Análise horária ou de madrugada:
    proibida

Valor original:
    preservado para auditoria


A correção principal é esta: a data não deve ser descartada; somente a precisão horária deve ser removida.
