Esse código descarta indevidamente uma data que pode ser recuperada.

Código novo
from __future__ import annotations

from dataclasses import dataclass
from datetime import date, datetime, time
from enum import StrEnum
import logging
import re
from typing import Optional


logger = logging.getLogger(__name__)


class OrigemArquivo(StrEnum):
    """Origens de arquivo reconhecidas pela ingestão."""

    ME_DATA = "ME_DATA"
    RELATORIO_ASSISTENCIAS = "RELATORIO_ASSISTENCIAS"


class PrecisaoTemporal(StrEnum):
    """Classificação da precisão disponível para um valor temporal."""

    DATA_HORA_CONFIAVEL = "DATA_HORA_CONFIAVEL"
    SOMENTE_DATA_CONFIAVEL = "SOMENTE_DATA_CONFIAVEL"
    DATA_AUSENTE = "DATA_AUSENTE"
    DATA_INVALIDA = "DATA_INVALIDA"


@dataclass(frozen=True, slots=True)
class DataNormalizada:
    """Representa uma data normalizada com rastreabilidade de qualidade."""

    valor_original: str
    data_evento: Optional[date]
    hora_evento: Optional[time]
    timestamp_evento: Optional[datetime]
    precisao: PrecisaoTemporal
    ano_corrigido: bool
    horario_informado: bool
    motivo_qualidade: Optional[str] = None


_PADRAO_DATA_HORA = re.compile(
    r"^(?P<ano>\d{4})-"
    r"(?P<mes>\d{2})-"
    r"(?P<dia>\d{2})"
    r"(?:[ T]"
    r"(?P<hora>\d{2}):"
    r"(?P<minuto>\d{2}):"
    r"(?P<segundo>\d{2})"
    r")?$"
)


def normalizar_data_operacional(
    valor: object,
    origem: OrigemArquivo,
    horario_zerado_representa_ausencia: bool = False,
) -> DataNormalizada:
    """
    Normaliza uma data operacional preservando sua precisão real.

    Regras:
    - Corrige o ano 0025 para 2025.
    - Preserva a data corrigida.
    - Trata 00:00:00 como horário ausente somente quando a estrutura
      do campo e a origem indicarem preenchimento técnico padrão.
    - Nunca fabrica um horário.
    - Preserva o conteúdo original para auditoria.
    """
    texto = str(valor or "").strip()

    if not texto:
        return DataNormalizada(
            valor_original="",
            data_evento=None,
            hora_evento=None,
            timestamp_evento=None,
            precisao=PrecisaoTemporal.DATA_AUSENTE,
            ano_corrigido=False,
            horario_informado=False,
            motivo_qualidade="VALOR_AUSENTE",
        )

    match = _PADRAO_DATA_HORA.fullmatch(texto)
    if not match:
        logger.warning(
            "Formato de data operacional não reconhecido",
            extra={
                "origem": origem.value,
                "valor_original": texto,
            },
        )
        return DataNormalizada(
            valor_original=texto,
            data_evento=None,
            hora_evento=None,
            timestamp_evento=None,
            precisao=PrecisaoTemporal.DATA_INVALIDA,
            ano_corrigido=False,
            horario_informado=False,
            motivo_qualidade="FORMATO_NAO_RECONHECIDO",
        )

    ano_original = int(match.group("ano"))
    ano_corrigido = ano_original == 25
    ano_normalizado = 2025 if ano_corrigido else ano_original

    try:
        data_evento = date(
            year=ano_normalizado,
            month=int(match.group("mes")),
            day=int(match.group("dia")),
        )
    except ValueError:
        logger.warning(
            "Data operacional inválida após normalização",
            extra={
                "origem": origem.value,
                "valor_original": texto,
                "ano_normalizado": ano_normalizado,
            },
        )
        return DataNormalizada(
            valor_original=texto,
            data_evento=None,
            hora_evento=None,
            timestamp_evento=None,
            precisao=PrecisaoTemporal.DATA_INVALIDA,
            ano_corrigido=ano_corrigido,
            horario_informado=False,
            motivo_qualidade="DATA_CALENDARIO_INVALIDA",
        )

    possui_horario_na_estrutura = match.group("hora") is not None

    if not possui_horario_na_estrutura:
        return DataNormalizada(
            valor_original=texto,
            data_evento=data_evento,
            hora_evento=None,
            timestamp_evento=None,
            precisao=PrecisaoTemporal.SOMENTE_DATA_CONFIAVEL,
            ano_corrigido=ano_corrigido,
            horario_informado=False,
            motivo_qualidade=(
                "ANO_0025_CORRIGIDO_SEM_HORARIO"
                if ano_corrigido
                else "CAMPO_SEM_HORARIO"
            ),
        )

    hora_evento = time(
        hour=int(match.group("hora")),
        minute=int(match.group("minuto")),
        second=int(match.group("segundo")),
    )

    horario_zerado = hora_evento == time(0, 0, 0)

    if horario_zerado and horario_zerado_representa_ausencia:
        logger.info(
            "Data corrigida e horário zerado tratado como não informado",
            extra={
                "origem": origem.value,
                "valor_original": texto,
                "data_normalizada": data_evento.isoformat(),
                "ano_corrigido": ano_corrigido,
            },
        )
        return DataNormalizada(
            valor_original=texto,
            data_evento=data_evento,
            hora_evento=None,
            timestamp_evento=None,
            precisao=PrecisaoTemporal.SOMENTE_DATA_CONFIAVEL,
            ano_corrigido=ano_corrigido,
            horario_informado=False,
            motivo_qualidade="HORARIO_000000_NAO_INFORMADO",
        )

    timestamp_evento = datetime.combine(data_evento, hora_evento)

    return DataNormalizada(
        valor_original=texto,
        data_evento=data_evento,
        hora_evento=hora_evento,
        timestamp_evento=timestamp_evento,
        precisao=PrecisaoTemporal.DATA_HORA_CONFIAVEL,
        ano_corrigido=ano_corrigido,
        horario_informado=True,
        motivo_qualidade=(
            "ANO_0025_CORRIGIDO"
            if ano_corrigido
            else None
        ),
    )

Uso para os campos conhecidos do ME
resultado = normalizar_data_operacional(
    valor="0025-12-31 00:00:00",
    origem=OrigemArquivo.ME_DATA,
    horario_zerado_representa_ausencia=True,
)

assert resultado.data_evento == date(2025, 12, 31)
assert resultado.hora_evento is None
assert resultado.timestamp_evento is None
assert resultado.ano_corrigido is True
assert resultado.horario_informado is False
assert resultado.precisao == PrecisaoTemporal.SOMENTE_DATA_CONFIAVEL

Uso para o relatório de assistências
resultado = normalizar_data_operacional(
    valor="2026-08-31 02:17:43",
    origem=OrigemArquivo.RELATORIO_ASSISTENCIAS,
    horario_zerado_representa_ausencia=False,
)

assert resultado.data_evento == date(2026, 8, 31)
assert resultado.hora_evento == time(2, 17, 43)
assert resultado.timestamp_evento == datetime(2026, 8, 31, 2, 17, 43)
assert resultado.horario_informado is True
assert resultado.precisao == PrecisaoTemporal.DATA_HORA_CONFIAVEL

Motivo da alteração
Recuperar corretamente o ano.
Preservar a data útil.
Não fabricar horário.
Evitar falsa ocorrência à meia-noite.
Permitir análise diária sem permitir análise horária.
Manter rastreabilidade do valor original.
Riscos da alteração
Aplicar a correção em colunas que não sejam datas.
Considerar todo 00:00:00 como ausente, inclusive em fontes confiáveis.
Preencher a coluna legada de timestamp sem indicar que o horário é desconhecido.
Quebrar consultas existentes que esperem exclusivamente datetime.
Misturar data de abertura, expediente, serviço e movimento.

Por isso, a mudança precisa ser feita no adaptador de ingestão e acompanhada por testes de regressão.

