    # -------------------------------------------------------------------
    with ui.row().classes('w-full h-full flex-nowrap gap-0'):
        sidebar_container()
        with ui.column().classes('flex-1 h-full overflow-hidden'):
            workspace()

ui.run(title="LCFO Forensic Intelligence", dark=True, port=8501, reload=False)
