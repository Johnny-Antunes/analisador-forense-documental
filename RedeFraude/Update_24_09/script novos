                    elif tipo_n == "telefone" and val_n: tels.append(val_n)
                    elif tipo_n == "placa" and val_n: placas.append(val_n)

                df_dados = consultar_detalhes_caso(cpfs, tels, placas) if (cpfs or tels or placas) else pd.DataFrame()
