<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Dossiê de Perfil - Consolidação de Contatos</title>
    <style>
        :root {
            --bg-page: #0b0f19;
            --card-bg: #111827;
            --card-surface: #1f2937;
            --border-color: #374151;
            --text-primary: #f9fafb;
            --text-secondary: #9ca3af;
            --accent: #38bdf8;
            --accent-hover: #0284c7;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-primary);
            padding: 24px;
            margin: 0;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 28px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
        }

        /* Painel de Inserção */
        .input-panel {
            background: var(--card-surface);
            border: 1px solid var(--border-color);
            padding: 16px;
            border-radius: 6px;
            margin-bottom: 24px;
        }

        .input-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        label {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: block;
            margin-bottom: 4px;
        }

        input, textarea {
            width: 100%;
            background: #111827;
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 9px;
            font-size: 13px;
            border-radius: 4px;
            box-sizing: border-box;
        }

        input:focus, textarea:focus {
            outline: none;
            border-color: var(--accent);
        }

        .btn-action {
            background: var(--accent);
            color: #0b0f19;
            border: none;
            padding: 10px 18px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            margin-top: 14px;
            transition: background 0.2s;
        }

        .btn-action:hover {
            background: var(--accent-hover);
        }

        /* Cabeçalho do Dossiê */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 12px;
            margin-bottom: 20px;
        }

        .badge {
            background: #1e293b;
            color: var(--accent);
            border: 1px solid #0369a1;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* Estrutura do Dossiê Visual */
        #dossie-output {
            display: none;
        }

        .data-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 16px;
        }

        .field-box {
            background: var(--card-surface);
            border: 1px solid var(--border-color);
            padding: 12px;
            border-radius: 6px;
        }

        .field-box strong {
            font-size: 10px;
            text-transform: uppercase;
            color: var(--text-secondary);
            letter-spacing: 0.5px;
            display: block;
            margin-bottom: 4px;
        }

        .field-box span {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .bio-content {
            white-space: pre-line;
            font-size: 13px;
            line-height: 1.5;
            color: #e5e7eb;
            font-weight: 400 !important;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            font-size: 13px;
        }

        th, td {
            border: 1px solid var(--border-color);
            padding: 10px;
            text-align: left;
        }

        th {
            background: #111827;
            color: var(--text-secondary);
            font-size: 11px;
            text-transform: uppercase;
        }

        td {
            background: var(--card-surface);
        }

        .url-highlight {
            color: var(--accent);
            font-family: monospace;
            font-size: 12px;
            word-break: break-all;
        }

        .footer {
            font-size: 11px;
            color: var(--text-secondary);
            border-top: 1px solid var(--border-color);
            padding-top: 12px;
            margin-top: 20px;
            display: flex;
            justify-content: space-between;
        }

        /* Impressão / PDF */
        @media print {
            body {
                background-color: var(--bg-page) !important;
                padding: 0;
            }
            .input-panel, .btn-action {
                display: none !important;
            }
            #dossie-output {
                display: block !important;
            }
            .container {
                border: none;
                box-shadow: none;
                max-width: 100%;
                padding: 0;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div>
            <h2 style="margin: 0; font-size: 18px; color: var(--text-primary);">Dossiê de Consolidação de Perfil</h2>
            <small style="color: var(--text-secondary);">Levantamento Cadastral e de Contatos</small>
        </div>
        <span class="badge">Registro de Evidência</span>
    </div>

    <!-- Painel de Inserção -->
    <div class="input-panel">
        <div class="input-grid">
            <div>
                <label>Usuário (@)</label>
                <input type="text" id="in_user" value="casadopetmn">
            </div>
            <div>
                <label>Nome do Perfil</label>
                <input type="text" id="in_nome" value="Casa do Pet">
            </div>
            <div>
                <label>Categoria / Segmento</label>
                <input type="text" id="in_categoria" value="Produto/serviço">
            </div>
            <div>
                <label>Telefone do WhatsApp (Botão do App)</label>
                <input type="text" id="in_tel_wa" placeholder="Ex: (85) 99999-9999">
            </div>
            <div>
                <label>Telefone Comercial (Informações de contato)</label>
                <input type="text" id="in_tel_contato" placeholder="Ex: (85) 3456-7890">
            </div>
            <div>
                <label>Nome / Rótulo do Link Externo</label>
                <input type="text" id="in_link_rotulo" placeholder="Ex: Página Facebook Casa Do Pet" value="Casa Do Pet">
            </div>
            <div style="grid-column: span 2;">
                <label>URL Real de Destino do Link Externo (Cole o link direto ou com l.instagram.com)</label>
                <input type="text" id="in_link_url" placeholder="Ex: https://facebook.com/casadopetmn ou cole o link copiado do botão">
            </div>
        </div>
        <div style="margin-top: 10px;">
            <label>Biografia Completa</label>
            <textarea id="in_bio" rows="4">🐶 Hospedagem familiar sem gaiolas
📍 Morada Nova - CE
🎬 Rotina real dos hóspedes
💖 +200 cães felizes
👇 Reserve a vaga do seu pet</textarea>
        </div>
        <button class="btn-action" onclick="gerarDossie()">Gerar Dossiê e Salvar em PDF</button>
    </div>

    <!-- Dossiê Final Estruturado -->
    <div id="dossie-output">
        <div class="data-grid">
            <div class="field-box">
                <strong>Identificador de Usuário</strong>
                <span id="out_user"></span>
            </div>
            <div class="field-box">
                <strong>Nome Apresentado</strong>
                <span id="out_nome"></span>
            </div>
            <div class="field-box">
                <strong>Segmento de Atuação</strong>
                <span id="out_categoria"></span>
            </div>
            <div class="field-box">
                <strong>Data / Hora da Coleta</strong>
                <span id="out_data"></span>
            </div>
        </div>

        <div class="field-box" style="margin-bottom: 16px;">
            <strong>Biografia Registrada</strong>
            <div id="out_bio" class="bio-content"></div>
        </div>

        <div class="field-box">
            <strong>Canais e Identificadores de Contato Localizados</strong>
            <table>
                <thead>
                    <tr>
                        <th>Canal de Contato</th>
                        <th>Identificador / Nome Exibido</th>
                        <th>URL / Destino Padrão Gerado</th>
                    </tr>
                </thead>
                <tbody id="out_tabela_contatos">
                    <!-- Gerado dinamicamente -->
                </tbody>
            </table>
        </div>

        <div class="footer">
            <span>Extração de Dados Públicos</span>
            <span>Documento Gerado Localmente</span>
        </div>
    </div>
</div>

<script>
function formatarUrlWhatsApp(numeroBruto) {
    if (!numeroBruto) return null;
    let digitos = numeroBruto.replace(/\D/g, '');
    if (!digitos) return null;

    if ((digitos.length === 10 || digitos.length === 11) && !digitos.startsWith('55')) {
        digitos = '55' + digitos;
    }

    return `https://wa.me/${digitos}`;
}

// Descompacta redirecionamentos do Instagram e padroniza URLs
function desempacotarUrl(urlBruta) {
    if (!urlBruta) return null;
    let limpa = urlBruta.trim();
    if (!limpa) return null;

    // Se veio pelo redirecionador do Instagram (l.instagram.com)
    if (limpa.includes('l.instagram.com')) {
        try {
            const params = new URLSearchParams(new URL(limpa).search);
            if (params.has('u')) {
                limpa = decodeURIComponent(params.get('u'));
            }
        } catch (e) {}
    }

    if (!limpa.startsWith('http://') && !limpa.startsWith('https://')) {
        if (limpa.includes('.') && !limpa.includes(' ')) {
            limpa = 'https://' + limpa;
        }
    }

    return limpa;
}

function gerarDossie() {
    const user = document.getElementById('in_user').value.trim();
    const nome = document.getElementById('in_nome').value.trim();
    const categoria = document.getElementById('in_categoria').value.trim();
    const bio = document.getElementById('in_bio').value;
    const telWa = document.getElementById('in_tel_wa').value.trim();
    const telCt = document.getElementById('in_tel_contato').value.trim();
    const linkRotulo = document.getElementById('in_link_rotulo').value.trim();
    const linkUrlBruta = document.getElementById('in_link_url').value.trim();

    // Atualiza cabeçalhos
    document.getElementById('out_user').innerText = '@' + user;
    document.getElementById('out_nome').innerText = nome || 'Não informado';
    document.getElementById('out_categoria').innerText = categoria || 'Geral';
    document.getElementById('out_bio').innerText = bio || 'Biografia vazia.';
    document.getElementById('out_data').innerText = new Date().toLocaleString('pt-BR');

    // Monta a tabela de contatos
    const tbody = document.getElementById('out_tabela_contatos');
    tbody.innerHTML = '';

    // Linha WhatsApp
    const waUrl = formatarUrlWhatsApp(telWa);
    tbody.innerHTML += `
        <tr>
            <td><strong>WhatsApp (Botão)</strong></td>
            <td>${telWa || '<span style="color:#6b7280">Não informado</span>'}</td>
            <td>${waUrl ? `<span class="url-highlight">${waUrl}</span>` : '<span style="color:#6b7280">-</span>'}</td>
        </tr>
    `;

    // Linha Telefone Comercial
    tbody.innerHTML += `
        <tr>
            <td><strong>Telefone Comercial</strong></td>
            <td>${telCt || '<span style="color:#6b7280">Não informado</span>'}</td>
            <td><span style="color:#9ca3af">Canal de Voz / Opções de Contato</span></td>
        </tr>
    `;

    // Linha Link Externo / Facebook
    const urlFinal = desempacotarUrl(linkUrlBruta);
    tbody.innerHTML += `
        <tr>
            <td><strong>Link Externo / Bio</strong></td>
            <td>${linkRotulo || '<span style="color:#6b7280">Link Externo</span>'}</td>
            <td>${urlFinal ? `<span class="url-highlight">${urlFinal}</span>` : '<span style="color:#6b7280">URL não informada</span>'}</td>
        </tr>
    `;

    // Exibe o dossiê e aciona impressão em PDF
    document.getElementById('dossie-output').style.display = 'block';
    window.print();
}
</script>

</body>
</html>
