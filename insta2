(() => {
    // 1. Identificação do Alvo
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const username = pathParts[0] || 'alvo';

    // 2. Varredura Profunda de Links (Facebook, sites externos e WhatsApp)
    const allLinks = Array.from(document.querySelectorAll('a'));
    let waLink = null;
    let waNumber = null;
    let externalLinks = [];

    for (const a of allLinks) {
        let href = a.href || '';
        
        // Decodifica redirecionamentos da Meta (l.instagram.com/?u=...)
        if (href.includes('l.instagram.com')) {
            try {
                const params = new URLSearchParams(new URL(href).search);
                if (params.has('u')) href = decodeURIComponent(params.get('u'));
            } catch (e) {}
        }

        // Verifica WhatsApp
        if (href.includes('wa.me') || href.includes('whatsapp.com')) {
            waLink = href;
            const match = href.match(/(?:phone=|wa\.me\/)(\+?[0-9]{10,15})/);
            if (match) waNumber = match[1].replace('+', '');
        } 
        // Identifica outros links (Facebook, Linktree, sites próprios)
        else if (href.startsWith('http') && !href.includes('instagram.com') && !href.includes('threads.net')) {
            const rotulo = a.innerText.trim() || href;
            if (!externalLinks.some(item => item.url === href)) {
                externalLinks.push({ label: rotulo, url: href });
            }
        }
    }

    // Função para padronizar e gerar URL wa.me
    const processarWhatsApp = (valor) => {
        if (!valor) return { numero: null, url: null };
        let digitos = valor.replace(/\D/g, '');
        if (!digitos) return { numero: valor, url: null };
        if ((digitos.length === 10 || digitos.length === 11) && !digitos.startsWith('55')) {
            digitos = '55' + digitos;
        }
        return {
            numero: valor,
            url: `https://wa.me/${digitos}`
        };
    };

    // 3. Entradas Interativas
    // WhatsApp: se não achou no DOM, solicita
    if (!waNumber) {
        const inputWa = prompt("Informe o número do WhatsApp (visto no app ou digite o número):", "");
        if (inputWa) {
            const res = processarWhatsApp(inputWa);
            waNumber = res.numero;
            waLink = res.url;
        }
    } else {
        const res = processarWhatsApp(waNumber);
        waLink = res.url || waLink;
    }

    // Telefone Comercial / Contato Fixo
    const telContato = prompt("Informe o outro telefone comercial (visto em 'Informações de contato' no app, se houver):", "") || "Não informado";

    // 4. Isolamento e Limpeza da Biografia
    const header = document.querySelector('header') || document.body;
    const rawLines = header.innerText.split('\n').map(l => l.trim()).filter(Boolean);
    
    // Filtra palavras de controle da interface para isolar a biografia
    const stopWords = ['posts', 'publicações', 'seguidores', 'seguindo', 'seguir', 'mensagem', 'enviar mensagem', 'contato', 'whatsapp', 'sugestões para você', 'ver tudo', 'editar perfil', 'usar o app'];
    const linhasBio = rawLines.filter(linha => {
        const lower = linha.toLowerCase();
        if (lower === username.toLowerCase()) return false;
        if (stopWords.some(termo => lower.includes(termo) && lower.length < 35)) return false;
        return true;
    });

    const bioFormatada = linhasBio.join('\n');
    const dataHora = new Date().toLocaleString('pt-BR');

    // 5. Montagem do HTML com Visual Escuro
    const relatorioHTML = `<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Dossiê OSINT - @${username}</title>
    <style>
        :root {
            --bg-body: #0b0f19;
            --bg-card: #111827;
            --bg-surface: #1f2937;
            --border: #374151;
            --text: #f9fafb;
            --text-muted: #9ca3af;
            --cyan: #38bdf8;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-body);
            color: var(--text);
            padding: 25px;
            margin: 0;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        .container {
            max-width: 780px;
            margin: 0 auto;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 26px;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.5);
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--border);
            padding-bottom: 12px;
            margin-bottom: 20px;
        }
        .badge {
            background: #1e293b;
            color: var(--cyan);
            border: 1px solid #0284c7;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .field-box {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 12px;
            margin-bottom: 14px;
        }
        .field-box label {
            display: block;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        .field-box span {
            font-size: 14px;
            font-weight: 600;
        }
        .bio-text {
            white-space: pre-line;
            font-size: 13px;
            line-height: 1.5;
            color: #e5e7eb;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 6px;
            font-size: 13px;
        }
        th, td {
            border: 1px solid var(--border);
            padding: 10px;
            text-align: left;
        }
        th {
            background: #111827;
            color: var(--text-muted);
            font-size: 11px;
            text-transform: uppercase;
        }
        td {
            background: var(--bg-surface);
        }
        .url-code {
            color: var(--cyan);
            font-family: monospace;
            font-size: 12px;
            word-break: break-all;
        }
        .btn-print {
            background: var(--cyan);
            color: #0b0f19;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 16px;
        }
        .footer {
            font-size: 11px;
            color: var(--text-muted);
            border-top: 1px solid var(--border);
            padding-top: 10px;
            margin-top: 16px;
            display: flex;
            justify-content: space-between;
        }
        @media print {
            body { background: var(--bg-body) !important; padding: 0; }
            .btn-print { display: none; }
            .container { border: none; box-shadow: none; max-width: 100%; padding: 0; }
        }
    </style>
</head>
<body>
    <div class="container">
        <button class="btn-print" onclick="window.print()">Salvar como PDF / Imprimir</button>
        
        <div class="header">
            <div>
                <h2 style="margin: 0; font-size: 18px;">Dossiê de Contatos do Perfil</h2>
                <small style="color: var(--text-muted);">Auditoria e Preservação de Evidência Digital</small>
            </div>
            <span class="badge">OSINT Instagram</span>
        </div>

        <div class="field-box">
            <label>Usuário Auditado</label>
            <span style="color: var(--cyan);">@${username}</span>
        </div>

        <div class="field-box">
            <label>Biografia Extraída</label>
            <div class="bio-text">${bioFormatada || 'Nenhum texto de biografia identificado.'}</div>
        </div>

        <div class="field-box">
            <label>Matriz Consolidada de Contatos</label>
            <table>
                <thead>
                    <tr>
                        <th>Canal de Contato</th>
                        <th>Dado / Número Registrado</th>
                        <th>Destino / URL Padrão</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>WhatsApp</strong></td>
                        <td>${waNumber || '<span style="color:var(--text-muted)">Não informado</span>'}</td>
                        <td>${waLink ? `<span class="url-code">${waLink}</span>` : '<span style="color:var(--text-muted)">-</span>'}</td>
                    </tr>
                    <tr>
                        <td><strong>Telefone Comercial</strong></td>
                        <td>${telContato}</td>
                        <td><span style="color:var(--text-muted)">Canal de voz / Cadastro</span></td>
                    </tr>
                    ${externalLinks.length > 0 ? externalLinks.map(l => `
                        <tr>
                            <td><strong>Link Externo (${l.label})</strong></td>
                            <td colspan="2"><span class="url-code">${l.url}</span></td>
                        </tr>
                    `).join('') : `
                        <tr>
                            <td><strong>Link Externo</strong></td>
                            <td colspan="2"><span style="color:var(--text-muted)">Nenhum link externo na bio</span></td>
                        </tr>
                    `}
                </tbody>
            </table>
        </div>

        <div class="footer">
            <span>Data de Extração: ${dataHora}</span>
            <span>Ambiente: Extração Local Segura</span>
        </div>
    </div>
</body>
</html>`;

    // 6. Exibição da nova aba
    const novaAba = window.open('', '_blank');
    if (novaAba) {
        novaAba.document.write(relatorioHTML);
        novaAba.document.close();
    } else {
        const blob = new Blob([relatorioHTML], { type: 'text/html;charset=utf-8;' });
        const linkDownload = document.createElement('a');
        linkDownload.href = URL.createObjectURL(blob);
        linkDownload.download = `auditoria_${username}.html`;
        document.body.appendChild(linkDownload);
        linkDownload.click();
        document.body.removeChild(linkDownload);
    }
})();
