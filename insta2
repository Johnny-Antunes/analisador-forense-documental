<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <title>Dossiê Pericial de Perfil</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f1f5f9; padding: 25px; margin: 0; color: #0f172a; }
        .container { max-width: 750px; margin: 0 auto; background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 25px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0f172a; padding-bottom: 10px; margin-bottom: 20px; }
        .badge { background: #991b1b; color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        .input-panel { background: #f8fafc; border: 1px solid #e2e8f0; padding: 15px; border-radius: 6px; margin-bottom: 20px; }
        .input-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        label { font-size: 11px; font-weight: bold; color: #475569; text-transform: uppercase; display: block; margin-bottom: 3px; }
        input, textarea { width: 100%; padding: 8px; font-size: 13px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; }
        button { background: #0f172a; color: white; border: none; padding: 10px 18px; border-radius: 4px; font-weight: bold; cursor: pointer; margin-top: 12px; }
        
        /* Secção do Relatório */
        #dossie-output { display: none; }
        .divergence-alert { background: #fff1f2; border: 1px solid #fecdd3; border-left: 4px solid #e11d48; padding: 12px; margin-bottom: 16px; font-size: 13px; color: #9f1239; }
        .data-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
        .field-box { background: #f8fafc; border: 1px solid #e2e8f0; padding: 10px; border-radius: 4px; }
        .field-box strong { font-size: 10px; text-transform: uppercase; color: #64748b; display: block; margin-bottom: 2px; }
        .field-box span { font-size: 13px; font-weight: 600; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
        th, td { border: 1px solid #e2e8f0; padding: 8px; text-align: left; }
        th { background: #f8fafc; }
        @media print { .input-panel, button { display: none; } #dossie-output { display: block !important; } body { background: #fff; padding: 0; } .container { border: none; box-shadow: none; max-width: 100%; } }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div>
            <h2 style="margin: 0; font-size: 18px;">Dossiê de Auditoria de Canal Digital</h2>
            <small style="color: #64748b;">Evidência Digital / Análise de Fraude</small>
        </div>
        <span class="badge">Auditoria Interna</span>
    </div>

    <!-- Painel de Inserção -->
    <div class="input-panel">
        <div class="input-grid">
            <div>
                <label>Utilizador (@)</label>
                <input type="text" id="in_user" value="casadopetmn">
            </div>
            <div>
                <label>Nome do Perfil</label>
                <input type="text" id="in_nome" value="Casa do Pet">
            </div>
            <div>
                <label>Telefone do WhatsApp (Botão)</label>
                <input type="text" id="in_tel_wa" placeholder="Ex: +55 (85) 9...">
            </div>
            <div>
                <label>Telefone em «Informações de contacto»</label>
                <input type="text" id="in_tel_contacto" placeholder="Ex: +55 (85) 3...">
            </div>
        </div>
        <div style="margin-top: 10px;">
            <label>Biografia / Observações</label>
            <textarea id="in_bio" rows="2">Hospedagem familiar sem gaiolas | Morada Nova - CE</textarea>
        </div>
        <button onclick="gerarDossie()">Gerar Dossiê e Imprimir em PDF</button>
    </div>

    <!-- Estrutura do Dossiê Formatado -->
    <div id="dossie-output">
        <div id="alerta-divergencia" class="divergence-alert"></div>

        <div class="data-grid">
            <div class="field-box"><strong>Utilizador Auditado</strong><span id="out_user"></span></div>
            <div class="field-box"><strong>Nome Apresentado</strong><span id="out_nome"></span></div>
        </div>

        <div class="field-box" style="margin-bottom: 16px;">
            <strong>Biografia Registada</strong>
            <span id="out_bio" style="font-weight: normal;"></span>
        </div>

        <div class="field-box" style="margin-bottom: 16px;">
            <strong>Matriz de Comparação de Contactos</strong>
            <table>
                <thead>
                    <tr>
                        <th>Canal de Atendimento</th>
                        <th>Contacto Extraído</th>
                        <th>Origem da Recolha</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>WhatsApp Operacional</strong></td>
                        <td id="out_wa"></td>
                        <td>Botão nativo de ação da aplicação</td>
                    </tr>
                    <tr>
                        <td><strong>Telefone Comercial</strong></td>
                        <td id="out_contacto"></td>
                        <td>Menu «Informações de contacto»</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div style="font-size: 11px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 10px; display: flex; justify-content: space-between;">
            <span id="out_data"></span>
            <span>Relatório Pericial Válido</span>
        </div>
    </div>
</div>

<script>
function gerarDossie() {
    const user = document.getElementById('in_user').value;
    const nome = document.getElementById('in_nome').value;
    const telWa = document.getElementById('in_tel_wa').value.trim();
    const telCt = document.getElementById('in_tel_contacto').value.trim();
    const bio = document.getElementById('in_bio').value;

    document.getElementById('out_user').innerText = '@' + user;
    document.getElementById('out_nome').innerText = nome;
    document.getElementById('out_bio').innerText = bio;
    document.getElementById('out_wa').innerText = telWa || 'Não facultado';
    document.getElementById('out_contacto').innerText = telCt || 'Não facultado';
    document.getElementById('out_data').innerText = 'Data de Emissão: ' + new Date().toLocaleString('pt-PT');

    const alerta = document.getElementById('alerta-divergencia');
    if (telWa && telCt && telWa !== telCt) {
        alerta.style.display = 'block';
        alerta.innerHTML = '<strong>Aviso de Fraude: Divergência de Identificadores Detetada</strong><br>' +
                           'O número de atendimento ativo no WhatsApp diverge do número registado nas opções institucionais de contacto.';
    } else {
        alerta.style.display = 'none';
    }

    document.getElementById('dossie-output').style.display = 'block';
    window.print();
}
</script>

</body>
</html>
