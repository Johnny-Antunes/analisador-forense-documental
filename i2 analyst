        const network = new vis.Network(container, data, options);

        function filterCluster(cId) {{
            if (cId === "ALL") {{
                // Carrega até os 250 nós mais conectados para não travar a tela
                nodesDataSet.clear();
                edgesDataSet.clear();
                nodesDataSet.add(rawNodes.slice(0, 300));
                edgesDataSet.add(rawEdges.filter(e => nodesDataSet.get(e.from) && nodesDataSet.get(e.to)));
            }} else {{
                const numId = parseInt(cId);
                const filteredNodes = rawNodes.filter(n => n.cluster === numId);
                const filteredEdges = rawEdges.filter(e => e.cluster === numId);
                
                nodesDataSet.clear();
                edgesDataSet.clear();
                nodesDataSet.add(filteredNodes);
                edgesDataSet.add(filteredEdges);
            }}
            setTimeout(() => network.fit({{animation: {{duration: 400}}}}), 150);
