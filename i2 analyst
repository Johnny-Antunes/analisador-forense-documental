import pandas as pd
import json
import re
import os
from pathlib import Path
import networkx as nx
import webbrowser

# =====================================================
# 1. CAMINHO DA PASTA COM AS EXTRAÇÕES DIÁRIAS
# =====================================================
# Dica: Você pode apontar direto para a rede (r"T:\Corporativo\...\Duplicidade de Placa")
# ou copiar alguns arquivos para uma pasta local "casos_duplicidade" para testar.

PASTA_ORIGEM = Path(__file__).parent / "casos_duplicidade"

# Se a pasta local não existir, cria para você testar
PASTA_ORIGEM.mkdir(exist_ok=True)

arquivos_excel = list(PASTA_ORIGEM.glob("*.xlsx"))

if not arquivos_excel:
    print(f"⚠️ Nenhum arquivo .xlsx encontrado em: {PASTA_ORIGEM}")
    print("Copie alguns arquivos diários para dentro dessa pasta e execute novamente.")
    exit()

print(f"📂 Encontrados {len(arquivos_excel)} arquivos diários. Consolidando base histórica...")

# =====================================================
# 2. CONSOLIDAÇÃO E LIMPEZA DOS DADOS
# =====================================================
lista_dfs = []

for arq in arquivos_excel:
    try:
        temp_df = pd.read_excel(arq)
        temp_df["_ARQUIVO_ORIGEM"] = arq.name
        lista_dfs.append(temp_df)
    except Exception as e:
        print(f"Erro ao ler {arq.name}: {e}")

df_bruto = pd.concat(lista_dfs, ignore_index=True)
print(f"📊 Total de registros consolidados: {len(df_bruto)} linhas.")

def limpar_str(val):
    if pd.isna(val):
        return ""
    v = str(val).strip()
    return "" if v.lower() in ["nan", "none", "null", "-", "nat"] else v

def limpar_placa(val):
    v = limpar_str(val).upper()
    return re.sub(r"[^A-Z0-9]", "", v)

def limpar_tel(val):
    v = limpar_str(val)
    nums = re.sub(r"\D", "", v)
    return nums if len(nums) >= 8 else v

def encontrar_col(df, nomes):
    for c in df.columns:
        c_low = str(c).lower()
        if any(n in c_low for n in nomes):
            return c
    return None

col_cpf = encontrar_col(df_bruto, ["cpf", "cnpj", "documento", "titular"])
col_tel = encontrar_col(df_bruto, ["telefone", "celular", "fone", "tel", "contato"])
col_placa = encontrar_col(df_bruto, ["placa", "veiculo", "veículo", "auto"])

print(f"🔍 Colunas detectadas: CPF/CNPJ: '{col_cpf}' | Tel: '{col_tel}' | Placa: '{col_placa}'")

# =====================================================
# 3. CONSTRUÇÃO MATEMÁTICA DOS GRAFOS E CLUSTERS (i2)
# =====================================================
G = nx.Graph()
linhas_processadas = []

for _, row in df_bruto.iterrows():
    cpf = limpar_str(row[col_cpf]) if col_cpf else ""
    tel = limpar_tel(row[col_tel]) if col_tel else ""
    placa = limpar_placa(row[col_placa]) if col_placa else ""
    
    # Ignora registros completamente vazios
    if not (cpf or tel or placa):
        continue
    
    entidades_linha = []
    if cpf:
        id_cpf = f"CPF_{cpf}"
        G.add_node(id_cpf, label=f"👤 {cpf}", group="cpf", title=f"CPF/CNPJ: {cpf}")
        entidades_linha.append(id_cpf)
    if tel:
        id_tel = f"TEL_{tel}"
        G.add_node(id_tel, label=f"🚨 {tel}", group="telefone", title=f"TELEFONE: {tel}")
        entidades_linha.append(id_tel)
    if placa:
        id_placa = f"PLACA_{placa}"
        G.add_node(id_placa, label=f"🚗 {placa}", group="placa", title=f"PLACA: {placa}")
        entidades_linha.append(id_placa)
        
    # Conecta as entidades que apareceram na mesma linha
    for i in range(len(entidades_linha)):
        for j in range(i + 1, len(entidades_linha)):
            G.add_edge(entidades_linha[i], entidades_linha[j])

# Identifica as Ilhas/Quadrilhas Independentes (Connected Components)
componentes = list(nx.connected_components(G))
componentes.sort(key=len, reverse=True) # Ordena dos maiores grupos para os menores

print(f"⚡ Redes de conexões identificadas: {len(componentes)} grupos distintos.")

# =====================================================
# 4. MONTAGEM DO JSON DE NÓS E ARESTAS COM METADADOS
# =====================================================
vis_nodes = []
vis_edges = []
cluster_summary = []

for cluster_id, comp in enumerate(componentes, 1):
    subgrafo = G.subgraph(comp)
    qtd_nos = len(comp)
    
    # Identifica o nó mais central (o maior Hub do cluster)
    graus = dict(subgrafo.degree())
    maior_hub_id = max(graus, key=graus.get)
    maior_hub_nome = G.nodes[maior_hub_id]["label"]
    
    cluster_summary.append({
        "cluster_id": cluster_id,
        "tamanho": qtd_nos,
        "hub": maior_hub_nome,
        "grau_hub": graus[maior_hub_id]
    })
    
    for n in comp:
        n_data = G.nodes[n]
        vis_nodes.append({
            "id": n,
            "label": n_data["label"],
            "group": n_data["group"],
            "title": n_data["title"],
            "cluster": cluster_id,
            "degree": graus[n]
        })
        
    for u, v in subgrafo.edges():
        vis_edges.append({
            "from": u,
            "to": v,
            "cluster": cluster_id
        })

